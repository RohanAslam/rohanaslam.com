---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, date, stack, status, links, tags, image, imageAlt, imageCaption } = entry.data;
const fmt = new Intl.DateTimeFormat('en-CA', { month: 'short', year: 'numeric' });

const ROUTES = {
  strategy: { n: 1, name: 'Line 1 · Strategy' },
  'ai-tools': { n: 2, name: 'Line 2 · AI Tools' },
  startup: { n: 3, name: 'Line 3 · Startup' },
  data: { n: 4, name: 'Line 4 · Data' },
  'earlier-work': { n: 5, name: 'Line 5 · Passion Projects' },
};
const routes = tags.map((t) => ROUTES[t]).filter(Boolean);
---

<Base title={`${title} · Rohan Aslam`} description={summary}>
  <article class="pt-10">
    <a href="/work" class="nav-link !text-(--ink-muted) hover:!text-(--cobalt)">← Back to all work</a>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      {routes.map((r) => <span class={`bullet bullet-${r.n} text-[13px] font-bold py-1 px-3`}>{r.name}</span>)}
    </div>

    <h1 class="h1 mt-4 text-[32px] sm:text-[44px]">{title}</h1>
    <hr class="rule-heavy mt-3" />

    <div class="label mt-3 flex flex-wrap gap-x-5 gap-y-1 text-[14px]">
      <span class="text-(--ink)">{fmt.format(date)}</span>
      <span class="text-(--ink-faint)">{status}</span>
      {stack.length > 0 && <span class="text-(--ink-faint)">{stack.join(' · ')}</span>}
    </div>

    <p class="mt-6 max-w-[85ch] text-[19px] leading-relaxed text-(--ink-muted)">{summary}</p>

    {
      (links.repo || links.live) && (
        <div class="mt-6 flex flex-wrap gap-4">
          {links.live && <a href={links.live} target="_blank" rel="noopener noreferrer" class="btn btn-primary text-[14px]">Live site</a>}
          {links.repo && <a href={links.repo} target="_blank" rel="noopener noreferrer" class="btn btn-secondary text-[14px]">Code</a>}
        </div>
      )
    }

    {/* Visual Display: Real Screenshot / Project Artifact or Branded Placeholder */}
    {
      image ? (
        <figure class="my-8 max-w-[85ch] border-2 border-(--ink) bg-(--ground) p-2 sm:p-3">
          <img
            src={image}
            alt={imageAlt || `${title} preview screenshot`}
            class="w-full h-auto border border-(--ink-faint)/20 block object-contain max-h-[560px] bg-(--surface)"
            loading="lazy"
          />
          <figcaption class="mt-2.5 px-1 font-mono text-[12px] font-bold text-(--ink-muted) flex flex-wrap items-center justify-between gap-2">
            <span>{imageCaption || `${title} · Project Artifact`}</span>
            <span class="text-(--ink-faint) uppercase tracking-wider text-[11px]">Artifact Capture</span>
          </figcaption>
        </figure>
      ) : (
        <figure class="my-8 max-w-[85ch] border-2 border-dashed border-(--ink-faint)/40 bg-(--surface) p-8 sm:p-12 text-center flex flex-col items-center justify-center min-h-[220px]">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-(--ground) border border-(--ink-faint)/40 font-mono text-[11px] font-bold uppercase tracking-wider text-(--ink-muted)">
            <span>◈</span>
            <span>Visual Artifact Pending</span>
          </div>
          <p class="mt-3 font-mono text-[12px] text-(--ink-faint) max-w-[50ch] leading-relaxed">
            Project screenshot and interface documentation for {title} will be uploaded here.
          </p>
        </figure>
      )
    }

    <hr class="rule-base my-10" />
    <div class="prose max-w-[85ch] text-[17px] leading-relaxed"><Content /></div>
  </article>
</Base>
