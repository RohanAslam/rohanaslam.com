---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RouteMap from '../components/RouteMap.astro';
import HeroCarousel from '../components/HeroCarousel.astro';

const all = (await getCollection('work')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const ROUTES: Record<string, number> = {
  strategy: 1,
  startup: 2,
  'ai-tools': 3,
  data: 4,
  'earlier-work': 5,
};

const heroLines = all.filter((e) => e.data.featured || e.data.status !== 'shipped').slice(0, 3);
---

<Base>
  <section class="py-12 sm:py-18 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-20 items-center">
      <div class="lg:col-span-7">
        <h1 class="station text-[36px] sm:text-[52px] xl:text-[56px] leading-[1.05]">
          Product strategy, AI tools & weekend builds.
        </h1>
        <p class="mt-6 text-[18px] sm:text-[19px] leading-relaxed text-(--ink)">
          I'm Rohan Aslam. I work in strategy and operations on the SunAdvantage team at Sun Life,
          following internships at Ontario Teachers', RBC, Dye & Durham, and the U of T Innovation Hub.
        </p>
        <p class="mt-4 text-[18px] sm:text-[19px] leading-relaxed text-(--ink)">
          On the side, I co-founded SmartSyllabus through UTM ICUBE, and I spend my free time building tools,
          exploring data, and learning through hands-on projects. Here is an overview of what I've worked on.
        </p>
        <div class="mt-5">
          <a href="/about" class="btn btn-secondary font-bold text-[14px]">About me →</a>
        </div>

        <!-- Featured work lines in the hero -->
        <div class="mt-8 border-t-2 border-(--rule-soft) pt-4">
          <div class="station text-[18px] sm:text-[20px] text-(--ink) mb-2.5">
            Featured work
          </div>
          <div class="grid gap-1">
            {heroLines.map((item) => {
              const lines = item.data.tags.map((t) => ROUTES[t]).filter(Boolean);
              return (
                <a
                  href={`/work/${item.id}`}
                  class="group flex items-center justify-between gap-3 border-b border-(--rule-soft) py-2 transition-opacity hover:opacity-80"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    {/* Multi-line overlap square showing all colors this work touches */}
                    <div
                      class="flex h-3.5 w-3.5 shrink-0 overflow-hidden border border-(--ink) bg-(--surface)"
                      title={`Lines: ${lines.join(', ')}`}
                      aria-hidden="true"
                    >
                      {lines.map((l) => (
                        <span class="h-full flex-1" style={`background: var(--line-${l});`} />
                      ))}
                    </div>
                    <span class="text-[15px] font-bold truncate text-(--ink) group-hover:text-(--cobalt) transition-colors">
                      {item.data.title}
                    </span>
                  </div>
                  <span class="label text-[12px] font-mono text-(--ink-faint) shrink-0 group-hover:text-(--ink)">
                    {item.data.status}
                  </span>
                </a>
              );
            })}
          </div>
          <div class="mt-5">
            <a href="/work" class="btn btn-primary font-bold text-[14px]">See the work →</a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 w-full">
        <HeroCarousel />
      </div>
    </div>
  </section>

  <section class="mt-8 sm:mt-12 lg:mt-16">
    <!-- Section Title, Subtitle, and Full-Width Reflection with bottom dividing rule -->
    <div class="border-b-2 border-(--ink) pb-5">
      <h2 class="station text-[28px] sm:text-[34px] font-bold tracking-tight text-(--ink)">
        Connections Across My Work
      </h2>
      <p class="font-mono text-[13px] font-bold text-(--ink-muted) uppercase tracking-wider mt-1">
        2022 to now · Five lines
      </p>
      <p class="mt-3.5 text-[15px] sm:text-[16px] leading-relaxed text-(--ink) w-full">
        Whether consciously or subconsciously, a lot of our work runs in parallel and builds directly on previous experiences. I put this visualization together to help me recognize those patterns in my own life, and to give anyone interested a way to see how my lessons, tools, and problems from one project carried forward into the next.
      </p>
    </div>

    <!-- Five Route Badges under the dividing line, introducing the visualization -->
    <div class="pt-4 pb-1 flex flex-wrap gap-2.5 text-[13px]">
      <span class="bullet bullet-1 text-[13px] font-bold">Line 1 · Corporate</span>
      <span class="bullet bullet-2 text-[13px] font-bold">Line 2 · Business Ventures</span>
      <span class="bullet bullet-3 text-[13px] font-bold">Line 3 · AI Tools</span>
      <span class="bullet bullet-4 text-[13px] font-bold">Line 4 · Data</span>
      <span class="bullet bullet-5 text-[13px] font-bold">Line 5 · Writing</span>
    </div>

    <RouteMap />

    <!--
      Second entry point, directly under the diagram. The route map is the
      chronology. The network is the other question people actually ask, which
      is whether any of it adds up to one thing.
    -->
    <a
      href="/network"
      class="group mt-8 flex flex-col gap-5 border-2 border-(--ink) p-6 no-underline transition-colors hover:border-(--cobalt) md:flex-row md:items-center md:justify-between md:gap-10"
    >
      <div class="min-w-0">
        <div class="label text-[12px] text-(--ink-faint)">Second view · 27 nodes · 36 links</div>
        <h2 class="h2 mt-2.5 text-(--ink)">See how projects connect</h2>
        <p class="mt-2.5 max-w-[66ch] text-[15px] leading-relaxed text-(--ink-muted)">
          The diagram above is the order things happened in. This one is what they have in
          common. Projects that share enough get pulled together until they overlap, and
          clicking a seam tells you why.
        </p>
      </div>
      <span class="btn btn-primary shrink-0 self-start md:self-center">Open the network</span>
    </a>
  </section>
</Base>
