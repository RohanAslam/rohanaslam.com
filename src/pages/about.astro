---
import Base from '../layouts/Base.astro';
import CompanyLogo from '../components/CompanyLogo.astro';

const experience = [
  {
    org: 'Sun Life',
    team: 'SunAdvantage',
    role: 'Strategy & Operations Specialist',
    timeframe: 'Sep 2026 – Present',
    type: 'Full Time',
    logo: 'sunlife' as const,
  },
  {
    org: 'SmartSyllabus',
    team: 'ICUBE at UTM',
    role: 'Co-Founder',
    timeframe: 'Jan 2026 – Present',
    type: 'Venture',
    logo: 'smartsyllabus' as const,
  },
  {
    org: 'Sun Life',
    team: 'Digital Transformation',
    role: 'Digital Transformation Coordinator',
    timeframe: 'May – Aug 2026',
    type: 'Internship',
    logo: 'sunlife' as const,
  },
  {
    org: 'Dye & Durham',
    team: 'Product',
    role: 'Product Intern',
    timeframe: 'Sep – Dec 2025',
    type: 'Internship',
    logo: 'dyedurham' as const,
  },
  {
    org: 'U of T Innovation Hub',
    team: 'Design Research',
    role: 'Design Researcher',
    timeframe: 'May – Aug 2025',
    type: 'Work-Study',
    logo: 'uoft' as const,
  },
  {
    org: "Ontario Teachers' Pension Plan",
    team: 'Experience Design & Innovation',
    role: 'Experience Design & Innovation Intern',
    timeframe: 'May 2023 – Aug 2024',
    type: 'Internship',
    logo: 'otpp' as const,
  },
  {
    org: 'RBC',
    team: 'Web Development',
    role: 'Web Developer Intern',
    timeframe: 'May – Aug 2022',
    type: 'Internship',
    logo: 'rbc' as const,
  },
];
---

<Base title="About · Rohan Aslam">
  <div class="pt-10">
    <h1 class="h1 text-[36px] sm:text-[48px]">About</h1>
    <hr class="rule-heavy mt-3" />

    {/* Responsive 2-column layout: Bio copy on left, photo template card on right */}
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="prose text-[18px] leading-relaxed lg:col-span-7 xl:col-span-8">
        <p>
          I'm Rohan Aslam and I live in Scarborough, which means I've spent a meaningful fraction
          of my life on the Lakeshore East line.
        </p>

        <p>
          I studied Communication, Culture, Information and Technology at U of T Mississauga with a
          computer science minor. It's an arts degree that taught me to build things, which sounds
          like a contradiction right up until you have to explain a technical decision to someone
          who doesn't care about the technology.
        </p>

        <p>
          Then four internships and a work-study term. Web development at RBC, on an internal tool
          for wealth management advisors. Sixteen straight months on the Experience Design and
          Innovation team at Ontario Teachers'. Design research at the U of T Innovation Hub, where
          I spent a summer talking to teachers across Ontario about problems I never would have
          guessed at from a desk. Product at Dye and Durham, on eCore. Then digital transformation
          at Sun Life, building agents in Copilot Studio and dashboards in Power BI, which turned
          into a full time offer on the SunAdvantage team.
        </p>

        <p>
          Somewhere in there I co-founded <a href="/work/smartsyllabus">SmartSyllabus</a> with two
          friends and it stopped being a course project. It's live at smartsyllabus.ca, and it's
          taught me more about strategy than any class did. Mostly because a course project can't
          fail in public.
        </p>

        <p>
          Most weekends I build something small. A Telegram bot that files my thoughts into Notion.
          A pipeline that ranks job postings so I stop scrolling. None of it is impressive on its
          own. It's how I find out whether an idea is any good before I spend three months arguing
          for it.
        </p>

        <p>
          Outside of that I hike. Algonquin, Petroglyphs, and one day trip to Charlevoix that
          involved leaving Scarborough at 3:40 in the morning and getting home twenty six hours
          later. I also help plan events and volunteer rotations in my community, which is project
          management with no budget and no authority. I recommend it to anyone who thinks they're
          good at logistics.
        </p>
      </div>

      {/* Photo Template Card */}
      <div class="lg:col-span-5 xl:col-span-4 w-full border-2 border-(--ink) bg-(--ground) p-4 flex flex-col">
        <div class="relative aspect-4/5 w-full overflow-hidden border-2 border-(--ink) bg-(--surface)">
          <img
            src="/images/rohan.jpg"
            alt="Rohan Aslam"
            width={800}
            height={1000}
            class="h-full w-full object-cover select-none"
          />
        </div>
        <div class="mt-3.5 flex items-center justify-between px-0.5">
          <div>
            <div class="font-bold text-[15px] leading-tight text-(--ink)">Rohan Aslam</div>
            <div class="label text-[12px] text-(--ink-faint) mt-0.5">Scarborough, ON</div>
          </div>
          <span class="bullet bullet-1 text-[11px] font-bold">Line 1 · Strategy</span>
        </div>
      </div>
    </div>

    <!-- Experience / Organizations departure board: Spans full width -->
    <div class="mt-16 w-full">
      <div class="label border-b-2 border-(--ink) pb-3 text-[16px] font-bold text-(--ink)">
        Organizations & Roles
      </div>
      <div class="border-t-0 w-full">
        {
          experience.map((item) => (
            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b-2 border-(--ink) py-5 transition-colors hover:bg-(--surface)">
              <div class="flex items-center gap-5 min-w-0">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center border-2 border-(--ink) bg-(--ground) text-(--ink) p-1.5">
                  <CompanyLogo name={item.logo} size={32} />
                </div>
                <div class="min-w-0">
                  <div class="text-[18px] sm:text-[19px] font-bold leading-tight text-(--ink) truncate">
                    {item.org}
                    <span class="ml-2 text-[14px] sm:text-[15px] font-normal text-(--ink-muted)">· {item.team}</span>
                  </div>
                  <div class="label text-[13px] sm:text-[14px] mt-1 text-(--ink-muted) truncate">{item.role}</div>
                </div>
              </div>
              <div class="label text-right text-(--ink) text-[13px] sm:text-[14px] shrink-0">
                <div class="font-bold">{item.timeframe}</div>
                <div class="text-(--ink-faint)">{item.type}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- What I'm looking for: Full-width banner callout -->
    <div class="mt-16 w-full mb-12">
      <div class="label border-b-2 border-(--ink) pb-3 text-[16px] font-bold text-(--ink)">
        What I'm looking for
      </div>
      <div class="mt-6 border-2 border-(--ink) bg-(--surface) p-6 sm:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-[70ch]">
          <p class="text-[18px] sm:text-[20px] font-bold leading-snug text-(--ink)">
            Strategy and operations roles at startups.
          </p>
          <p class="mt-2 text-[15px] sm:text-[16px] leading-relaxed text-(--ink-muted)">
            The kind of job where working out what matters and making it real are the same task. If that's your team,
            reach out.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a href="mailto:rohanaslam24@gmail.com" class="btn btn-primary">
            Email me
          </a>
          <a href="https://www.linkedin.com/in/rohanaslam" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>
</Base>
