---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rohan Aslam',
  description = 'Strategy and AI builder in Toronto. I think in strategy and prove it by shipping.',
} = Astro.props;

const nav = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];

const socials = [
  {
    href: 'https://www.linkedin.com/in/rohanaslam',
    label: 'LinkedIn',
    sub: 'Profile',
    icon: 'linkedin' as const,
  },
  {
    href: 'https://github.com/RohanAslam',
    label: 'GitHub',
    sub: 'Code',
    icon: 'github' as const,
  },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <!-- The system bar. Five routes. Every page, always. -->
    <div class="system-bar" aria-hidden="true">
      <span style="background:var(--line-1)"></span>
      <span style="background:var(--line-2)"></span>
      <span style="background:var(--line-3)"></span>
      <span style="background:var(--line-4)"></span>
      <span style="background:var(--line-5)"></span>
    </div>

    <div class="mx-auto max-w-[1680px] px-5 sm:px-8 lg:px-12">
      <header class="flex flex-wrap items-center justify-between gap-y-4 border-b-2 border-(--ink) py-6">
        <a href="/" class="station text-[22px] tracking-tight transition-colors hover:text-(--cobalt)">
          Rohan Aslam
        </a>

        <nav class="flex flex-wrap items-center gap-x-6 sm:gap-x-8 gap-y-2">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'nav-link',
                  path.startsWith(item.href) && '!text-(--cobalt) font-bold underline',
                ]}
              >
                {item.label}
              </a>
            ))
          }

          <span class="hidden h-5 w-[2px] bg-(--rule-soft) sm:inline-block" aria-hidden="true"></span>

          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="nav-link"
                title={`${s.label} (${s.sub})`}
              >
                <Icon name={s.icon} size={17} />
                <span>{s.label}</span>
              </a>
            ))
          }
        </nav>
      </header>

      <main class="pb-28">
        <slot />
      </main>

      <hr class="rule-heavy" />
      <footer class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4 py-8">
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
          <a
            class="footer-link"
            href="https://www.linkedin.com/in/rohanaslam"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="linkedin" size={17} />
            <span>LinkedIn</span>
          </a>
          <a
            class="footer-link"
            href="https://github.com/RohanAslam"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" size={17} />
            <span>GitHub</span>
          </a>
          <a
            class="footer-link"
            href="mailto:rohanaslam24@gmail.com"
          >
            <Icon name="mail" size={17} />
            <span>rohanaslam24@gmail.com</span>
          </a>
        </div>

        <div class="label text-[13px] text-(--ink-faint)">
          43.7°N 79.3°W · TORONTO · LINE 1–5
        </div>
      </footer>
    </div>
  </body>
</html>
