---
/**
 * ExperienceBulletin.astro
 *
 * Clean, borderless Polaroid photo cluster showcasing real dispatches
 * from Rohan's ventures, internships, and research.
 * - No outer box border, no background texture, no shuffle button.
 * - Compact height (under 480px on desktop, ~250px on mobile).
 * - Varied photo sizes and aspect ratios (including portrait snapshot).
 * - 3D tactility via solid ink depth blocks and enameled pushpins.
 * - Interactive hover & click elevation.
 */
import CompanyLogo from './CompanyLogo.astro';

interface PinnedPhoto {
  id: string;
  company: 'smartsyllabus' | 'sunlife' | 'otpp' | 'dyedurham' | 'uoft';
  org: string;
  role: string;
  image: string;
  alt: string;
  objectPosition?: string;
  line: number;
  tilt: string;
  z: number;
  desktopStyle: string;
  aspectClass: string;
}

const pins: PinnedPhoto[] = [
  {
    id: 'smartsyllabus',
    company: 'smartsyllabus',
    org: 'SmartSyllabus',
    role: 'Co-Founder · 2026 to Present',
    image: '/images/carousel/smartsyllabus.jpg',
    alt: 'SmartSyllabus founding team at University of Toronto ICUBE',
    objectPosition: 'center center',
    line: 2,
    tilt: '-2.5deg',
    z: 10,
    desktopStyle: 'left: 0%; top: 12px; width: 275px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'sunlife',
    company: 'sunlife',
    org: 'Sun Life',
    role: 'Strategy & Ops · 2026 to Present',
    image: '/images/carousel/sunlife.jpg',
    alt: 'Sun Life team with Rohan Aslam',
    objectPosition: 'center center',
    line: 1,
    tilt: '2deg',
    z: 12,
    desktopStyle: 'right: 1%; top: 8px; width: 255px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'uoft',
    company: 'uoft',
    org: 'U of T Innovation Hub',
    role: 'Design Research · 2025',
    image: '/images/carousel/innovationHub.JPG',
    alt: 'U of T Innovation Hub educator fieldwork research',
    objectPosition: 'center 70%',
    line: 4,
    tilt: '-1.5deg',
    z: 15,
    desktopStyle: 'left: 36%; top: 24px; width: 175px;',
    aspectClass: 'aspect-[3/4]',
  },
  {
    id: 'otpp',
    company: 'otpp',
    org: "Ontario Teachers'",
    role: 'Experience Design · 2023 to 2024',
    image: '/images/carousel/otpp.jpg',
    alt: 'Ontario Teachers Experience Design Lab internship team',
    objectPosition: 'center center',
    line: 5,
    tilt: '1.8deg',
    z: 11,
    desktopStyle: 'left: 5%; bottom: 10px; width: 245px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'dyedurham',
    company: 'dyedurham',
    org: 'Dye & Durham',
    role: 'Product Intern · 2025',
    image: '/images/carousel/dyedurham.jpg',
    alt: 'Dye & Durham team event with Rohan Aslam',
    objectPosition: 'center center',
    line: 1,
    tilt: '-2.2deg',
    z: 13,
    desktopStyle: 'right: 5%; bottom: 14px; width: 220px;',
    aspectClass: 'aspect-[1.35/1]',
  },
];
---

<div class="experience-cluster w-full select-none" id="experience-cluster" aria-label="Pinned career experience photos">
  {/* Desktop & Tablet Collage Stage: Compact bounded canvas (under 485px) with varied photo sizes */}
  <div class="hidden sm:block relative w-full h-[470px] xl:h-[490px]">
    {
      pins.map((card, i) => (
        <article
          class="polaroid-card group absolute bg-white dark:bg-(--surface) border-2 border-(--ink) p-2 transition-all duration-200 cursor-pointer"
          data-index={i}
          data-tilt={card.tilt}
          style={`--card-tilt: ${card.tilt}; z-index: ${card.z}; ${card.desktopStyle}`}
          tabindex="0"
          role="button"
          aria-label={`${card.org}: ${card.role}. Click to bring forward.`}
        >
          {/* Tactile 3D Drop Block (strictly no box-shadow!) */}
          <div
            class="polaroid-depth-block absolute inset-0 bg-(--ink) -z-10 translate-x-1 translate-y-1 transition-transform duration-200 group-hover:translate-x-1.5 group-hover:translate-y-1.5"
            aria-hidden="true"
          />

          {/* Enameled Pushpin Tack at Top Center */}
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center pointer-events-none" aria-hidden="true">
            <div
              class="h-3.5 w-3.5 rounded-full border-2 border-(--ink) relative flex items-center justify-center transition-transform group-hover:scale-110"
              style={`background: var(--line-${card.line});`}
            >
              <span class="absolute top-0.5 left-0.5 h-1 w-1 rounded-full bg-white opacity-90" />
              <span class="h-1 w-1 rounded-full bg-(--ink) opacity-30" />
            </div>
            <div class="h-1.5 w-[2px] bg-(--ink) -mt-0.5" />
          </div>

          {/* Polaroid Photo Frame */}
          <div class={`relative w-full overflow-hidden border border-(--ink) bg-(--ground) ${card.aspectClass}`}>
            <img
              src={card.image}
              alt={card.alt}
              width={500}
              height={375}
              class="h-full w-full object-cover"
              style={card.objectPosition ? `object-position: ${card.objectPosition};` : undefined}
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </div>

          {/* Polaroid Chin: Clean, punchy context */}
          <div class="pt-2 pb-0.5 px-1">
            <div class="flex items-center gap-1.5 min-w-0">
              <CompanyLogo name={card.company} size={14} class="shrink-0" />
              <h3 class="text-[13px] font-bold leading-tight text-(--ink) truncate">
                {card.org}
              </h3>
            </div>
            <div class="mt-0.5 font-mono text-[10.5px] text-(--ink-muted) truncate">
              {card.role}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  {/* Mobile View: Horizontal scrolling snapshot strip (compact ~240px height, no long page stretching) */}
  <div class="sm:hidden flex gap-4 overflow-x-auto pb-4 pt-2 -mx-5 px-5 snap-x scrollbar-none">
    {
      pins.map((card, i) => (
        <article
          class="polaroid-card group relative w-[230px] shrink-0 snap-center bg-white dark:bg-(--surface) border-2 border-(--ink) p-2 transition-all duration-200 cursor-pointer"
          data-index={i}
          data-tilt={card.tilt}
          style={`--card-tilt: ${card.tilt}; z-index: ${card.z};`}
          tabindex="0"
          role="button"
          aria-label={`${card.org}: ${card.role}`}
        >
          {/* Tactile 3D Drop Block */}
          <div
            class="polaroid-depth-block absolute inset-0 bg-(--ink) -z-10 translate-x-1 translate-y-1"
            aria-hidden="true"
          />

          {/* Enameled Pushpin Tack */}
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center pointer-events-none" aria-hidden="true">
            <div
              class="h-3.5 w-3.5 rounded-full border-2 border-(--ink) relative flex items-center justify-center"
              style={`background: var(--line-${card.line});`}
            >
              <span class="absolute top-0.5 left-0.5 h-1 w-1 rounded-full bg-white opacity-90" />
              <span class="h-1 w-1 rounded-full bg-(--ink) opacity-30" />
            </div>
            <div class="h-1.5 w-[2px] bg-(--ink) -mt-0.5" />
          </div>

          {/* Photo Frame */}
          <div class={`relative w-full overflow-hidden border border-(--ink) bg-(--ground) ${card.aspectClass}`}>
            <img
              src={card.image}
              alt={card.alt}
              width={460}
              height={345}
              class="h-full w-full object-cover"
              style={card.objectPosition ? `object-position: ${card.objectPosition};` : undefined}
              loading="lazy"
            />
          </div>

          {/* Chin */}
          <div class="pt-2 pb-0.5 px-1">
            <div class="flex items-center gap-1.5 min-w-0">
              <CompanyLogo name={card.company} size={14} class="shrink-0" />
              <h3 class="text-[13px] font-bold leading-tight text-(--ink) truncate">
                {card.org}
              </h3>
            </div>
            <div class="mt-0.5 font-mono text-[10.5px] text-(--ink-muted) truncate">
              {card.role}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  /* Subtle organic rotation per card */
  .polaroid-card {
    transform: rotate(var(--card-tilt, 0deg));
    will-change: transform, z-index;
  }

  /* Lift and straighten slightly on hover or focus */
  .polaroid-card:hover,
  .polaroid-card:focus-visible {
    transform: rotate(0deg) scale(1.04) !important;
    z-index: 50 !important;
  }

  /* Active clicked state */
  .polaroid-card.is-active {
    transform: rotate(0deg) scale(1.05) !important;
  }

  .polaroid-card.is-active .polaroid-depth-block {
    transform: translate(6px, 6px);
  }
</style>

<script is:inline>
  (function () {
    const cluster = document.getElementById('experience-cluster');
    if (!cluster) return;

    const cards = Array.from(cluster.querySelectorAll('.polaroid-card'));
    let topZ = 30;
    let activeCard = null;

    function bringToFront(card) {
      topZ += 2;
      card.style.zIndex = topZ;

      if (activeCard && activeCard !== card) {
        activeCard.classList.remove('is-active');
      }

      card.classList.add('is-active');
      activeCard = card;
    }

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        if (card !== activeCard) {
          topZ += 1;
          card.style.zIndex = topZ;
        }
      });

      card.addEventListener('click', (e) => {
        e.stopPropagation();
        bringToFront(card);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          bringToFront(card);
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!cluster.contains(e.target) && activeCard) {
        activeCard.classList.remove('is-active');
        activeCard = null;
      }
    });
  })();
</script>
