---
/**
 * ExperienceBulletin.astro
 *
 * Inverted Polaroid photo cluster with dark card face, crisp white typography,
 * route-colored pushpins, tighter cluster spacing, and enlarged photos.
 * - Flipped color scheme: Black/ink card face with white text and light offset depth block.
 * - Larger photos for SmartSyllabus (315px), Sun Life (295px), OT (285px), Dye & Durham (265px).
 * - Design researcher photo preserved as compact portrait snapshot (175px).
 * - Clean title of the company only (no dates or years).
 * - Photos moved closer together for a tighter cluster and future photo additions.
 */
import CompanyLogo from './CompanyLogo.astro';

interface PinnedPhoto {
  id: string;
  company: 'smartsyllabus' | 'sunlife' | 'otpp' | 'dyedurham' | 'uoft';
  org: string;
  image: string;
  alt: string;
  objectPosition?: string;
  line: number;
  tilt: string;
  z: number;
  desktopStyle: string;
  aspectClass: string;
}

const pins: PinnedPhoto[] = [
  {
    id: 'smartsyllabus',
    company: 'smartsyllabus',
    org: 'SmartSyllabus',
    image: '/images/carousel/smartsyllabus.jpg',
    alt: 'SmartSyllabus founding team at University of Toronto ICUBE',
    objectPosition: 'center center',
    line: 2,
    tilt: '-2.5deg',
    z: 10,
    desktopStyle: 'left: 3%; top: 8px; width: 315px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'sunlife',
    company: 'sunlife',
    org: 'Sun Life',
    image: '/images/carousel/sunlife.jpg',
    alt: 'Sun Life team with Rohan Aslam',
    objectPosition: 'center center',
    line: 1,
    tilt: '2deg',
    z: 12,
    desktopStyle: 'right: 3%; top: 16px; width: 295px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'uoft',
    company: 'uoft',
    org: 'U of T Innovation Hub',
    image: '/images/carousel/innovationHub.JPG',
    alt: 'U of T Innovation Hub educator fieldwork research',
    objectPosition: 'center 70%',
    line: 4,
    tilt: '-1deg',
    z: 15,
    desktopStyle: 'left: 36%; top: 42px; width: 175px;',
    aspectClass: 'aspect-[3/4]',
  },
  {
    id: 'otpp',
    company: 'otpp',
    org: "Ontario Teachers'",
    image: '/images/carousel/otpp.jpg',
    alt: 'Ontario Teachers Experience Design Lab internship team',
    objectPosition: 'center center',
    line: 5,
    tilt: '1.8deg',
    z: 11,
    desktopStyle: 'left: 6%; bottom: 8px; width: 285px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'dyedurham',
    company: 'dyedurham',
    org: 'Dye & Durham',
    image: '/images/carousel/dyedurham.jpg',
    alt: 'Dye & Durham team event with Rohan Aslam',
    objectPosition: 'center center',
    line: 1,
    tilt: '-2.2deg',
    z: 13,
    desktopStyle: 'right: 6%; bottom: 12px; width: 265px;',
    aspectClass: 'aspect-[1.35/1]',
  },
];
---

<div class="experience-cluster w-full select-none" id="experience-cluster" aria-label="Pinned career experience photos">
  {/* Desktop & Tablet Collage Stage: Compact, tightly spaced cluster with varied photo sizes */}
  <div class="hidden sm:block relative w-full h-[490px] xl:h-[510px]">
    {
      pins.map((card, i) => (
        <article
          class="polaroid-card group absolute bg-(--ink) text-(--ground) border-2 border-(--ink) p-2 transition-all duration-200 cursor-pointer"
          data-index={i}
          data-tilt={card.tilt}
          style={`--card-tilt: ${card.tilt}; z-index: ${card.z}; ${card.desktopStyle}`}
          tabindex="0"
          role="button"
          aria-label={`${card.org}. Click to bring forward.`}
        >
          {/* Flipped 3D Depth Block (Light surface block with ink border behind dark card, strictly no box-shadow!) */}
          <div
            class="polaroid-depth-block absolute inset-0 bg-white dark:bg-(--surface) border-2 border-(--ink) -z-10 translate-x-1.5 translate-y-1.5 transition-transform duration-200 group-hover:translate-x-2 group-hover:translate-y-2"
            aria-hidden="true"
          />

          {/* Enameled Pushpin Tack at Top Center (colored by strategy/route line) */}
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center pointer-events-none" aria-hidden="true">
            <div
              class="h-3.5 w-3.5 rounded-full border-2 border-(--ink) relative flex items-center justify-center transition-transform group-hover:scale-110"
              style={`background: var(--line-${card.line});`}
            >
              <span class="absolute top-0.5 left-0.5 h-1 w-1 rounded-full bg-white opacity-90" />
              <span class="h-1 w-1 rounded-full bg-(--ink) opacity-30" />
            </div>
            <div class="h-1.5 w-[2px] bg-(--ink) -mt-0.5" />
          </div>

          {/* Photo Frame */}
          <div class={`relative w-full overflow-hidden border border-white/20 bg-black ${card.aspectClass}`}>
            <img
              src={card.image}
              alt={card.alt}
              width={600}
              height={450}
              class="h-full w-full object-cover"
              style={card.objectPosition ? `object-position: ${card.objectPosition};` : undefined}
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </div>

          {/* Flipped Polaroid Chin: Bold White Company Title Only */}
          <div class="pt-2 pb-1 px-1 flex items-center gap-2 min-w-0">
            <div class="flex h-5 w-5 shrink-0 items-center justify-center bg-white border border-white/30 p-0.5" aria-hidden="true">
              <CompanyLogo name={card.company} size={14} class="shrink-0" />
            </div>
            <h3 class="text-[14px] sm:text-[15px] font-bold leading-tight text-white tracking-tight truncate">
              {card.org}
            </h3>
          </div>
        </article>
      ))
    }
  </div>

  {/* Mobile View: Horizontal scrolling snapshot strip (compact ~240px height, no page stretching) */}
  <div class="sm:hidden flex gap-4 overflow-x-auto pb-4 pt-2 -mx-5 px-5 snap-x scrollbar-none">
    {
      pins.map((card, i) => (
        <article
          class="polaroid-card group relative w-[240px] shrink-0 snap-center bg-(--ink) text-(--ground) border-2 border-(--ink) p-2 transition-all duration-200 cursor-pointer"
          data-index={i}
          data-tilt={card.tilt}
          style={`--card-tilt: ${card.tilt}; z-index: ${card.z};`}
          tabindex="0"
          role="button"
          aria-label={card.org}
        >
          {/* Flipped 3D Depth Block */}
          <div
            class="polaroid-depth-block absolute inset-0 bg-white dark:bg-(--surface) border-2 border-(--ink) -z-10 translate-x-1.5 translate-y-1.5"
            aria-hidden="true"
          />

          {/* Enameled Pushpin Tack */}
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center pointer-events-none" aria-hidden="true">
            <div
              class="h-3.5 w-3.5 rounded-full border-2 border-(--ink) relative flex items-center justify-center"
              style={`background: var(--line-${card.line});`}
            >
              <span class="absolute top-0.5 left-0.5 h-1 w-1 rounded-full bg-white opacity-90" />
              <span class="h-1 w-1 rounded-full bg-(--ink) opacity-30" />
            </div>
            <div class="h-1.5 w-[2px] bg-(--ink) -mt-0.5" />
          </div>

          {/* Photo Frame */}
          <div class={`relative w-full overflow-hidden border border-white/20 bg-black ${card.aspectClass}`}>
            <img
              src={card.image}
              alt={card.alt}
              width={480}
              height={360}
              class="h-full w-full object-cover"
              style={card.objectPosition ? `object-position: ${card.objectPosition};` : undefined}
              loading="lazy"
            />
          </div>

          {/* Flipped Chin: Title Only */}
          <div class="pt-2 pb-1 px-1 flex items-center gap-2 min-w-0">
            <div class="flex h-5 w-5 shrink-0 items-center justify-center bg-white border border-white/30 p-0.5" aria-hidden="true">
              <CompanyLogo name={card.company} size={14} class="shrink-0" />
            </div>
            <h3 class="text-[14px] font-bold leading-tight text-white tracking-tight truncate">
              {card.org}
            </h3>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  /* Subtle organic rotation per card */
  .polaroid-card {
    transform: rotate(var(--card-tilt, 0deg));
    will-change: transform, z-index;
  }

  /* Lift and straighten slightly on hover or focus */
  .polaroid-card:hover,
  .polaroid-card:focus-visible {
    transform: rotate(0deg) scale(1.04) !important;
    z-index: 50 !important;
  }

  /* Active clicked state */
  .polaroid-card.is-active {
    transform: rotate(0deg) scale(1.05) !important;
  }

  .polaroid-card.is-active .polaroid-depth-block {
    transform: translate(7px, 7px);
  }
</style>

<script is:inline>
  (function () {
    const cluster = document.getElementById('experience-cluster');
    if (!cluster) return;

    const cards = Array.from(cluster.querySelectorAll('.polaroid-card'));
    let topZ = 30;
    let activeCard = null;

    function bringToFront(card) {
      topZ += 2;
      card.style.zIndex = topZ;

      if (activeCard && activeCard !== card) {
        activeCard.classList.remove('is-active');
      }

      card.classList.add('is-active');
      activeCard = card;
    }

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        if (card !== activeCard) {
          topZ += 1;
          card.style.zIndex = topZ;
        }
      });

      card.addEventListener('click', (e) => {
        e.stopPropagation();
        bringToFront(card);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          bringToFront(card);
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!cluster.contains(e.target) && activeCard) {
        activeCard.classList.remove('is-active');
        activeCard = null;
      }
    });
  })();
</script>
