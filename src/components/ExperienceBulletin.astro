---
/**
 * ExperienceBulletin.astro
 *
 * Authentic classic Polaroid photo cluster:
 * - Crisp white Polaroid cards with 2px ink borders and white bottom chins.
 * - Bold, crystal-clear black text that is NEVER cut off across any viewport.
 * - Borderless, enlarged company logos (22px) with zero outlines or wrapper borders.
 * - Wider card width for U of T Innovation Hub (235px) so its full name renders with zero truncation.
 * - Clean, elegant enameled transit route pins (single clean dome, route-colored).
 * - Smooth responsive behavior across mobile, tablet, and desktop viewports.
 */
import CompanyLogo from './CompanyLogo.astro';

interface PinnedPhoto {
  id: string;
  company: 'smartsyllabus' | 'sunlife' | 'otpp' | 'dyedurham' | 'uoft';
  org: string;
  image: string;
  alt: string;
  objectPosition?: string;
  line: number;
  tilt: string;
  z: number;
  desktopStyle: string;
  aspectClass: string;
}

const pins: PinnedPhoto[] = [
  {
    id: 'smartsyllabus',
    company: 'smartsyllabus',
    org: 'SmartSyllabus',
    image: '/images/carousel/smartsyllabus.jpg',
    alt: 'SmartSyllabus founding team at University of Toronto ICUBE',
    objectPosition: 'center center',
    line: 2,
    tilt: '-2.5deg',
    z: 10,
    desktopStyle: 'left: 2%; top: 8px; width: 315px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'sunlife',
    company: 'sunlife',
    org: 'Sun Life',
    image: '/images/carousel/sunlife.jpg',
    alt: 'Sun Life team with Rohan Aslam',
    objectPosition: 'center center',
    line: 1,
    tilt: '2deg',
    z: 12,
    desktopStyle: 'right: 2%; top: 16px; width: 295px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'uoft',
    company: 'uoft',
    org: 'U of T Innovation Hub',
    image: '/images/carousel/innovationHub.JPG',
    alt: 'U of T Innovation Hub educator fieldwork research',
    objectPosition: 'center 70%',
    line: 4,
    tilt: '-1deg',
    z: 15,
    desktopStyle: 'left: 33%; top: 38px; width: 235px;',
    aspectClass: 'aspect-[3/4]',
  },
  {
    id: 'otpp',
    company: 'otpp',
    org: "Ontario Teachers'",
    image: '/images/carousel/otpp.jpg',
    alt: 'Ontario Teachers Experience Design Lab internship team',
    objectPosition: 'center center',
    line: 5,
    tilt: '1.8deg',
    z: 11,
    desktopStyle: 'left: 5%; bottom: 8px; width: 285px;',
    aspectClass: 'aspect-[1.35/1]',
  },
  {
    id: 'dyedurham',
    company: 'dyedurham',
    org: 'Dye & Durham',
    image: '/images/carousel/dyedurham.jpg',
    alt: 'Dye & Durham team event with Rohan Aslam',
    objectPosition: 'center center',
    line: 1,
    tilt: '-2.2deg',
    z: 13,
    desktopStyle: 'right: 5%; bottom: 12px; width: 265px;',
    aspectClass: 'aspect-[1.35/1]',
  },
];
---

<div class="experience-cluster w-full select-none" id="experience-cluster" aria-label="Pinned career experience photos">
  {/* Desktop & Tablet Collage Stage: Compact, tightly clustered canvas with zero text cutoffs */}
  <div class="hidden sm:block relative w-full h-[500px] xl:h-[520px]">
    {
      pins.map((card, i) => (
        <article
          class="polaroid-card group absolute bg-white border-2 border-(--ink) p-2 sm:p-2.5 pb-3 transition-transform duration-200 cursor-pointer"
          data-index={i}
          data-tilt={card.tilt}
          data-base-z={card.z}
          style={`--card-tilt: ${card.tilt}; z-index: ${card.z}; ${card.desktopStyle}`}
          tabindex="0"
          role="button"
          aria-label={`${card.org}. Click to bring forward.`}
        >
          {/* Clean Enameled Transit Route Pin at Top Center */}
          <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 z-20 pointer-events-none" aria-hidden="true">
            <div
              class="h-4 w-4 rounded-full border-2 border-(--ink) relative transition-transform group-hover:scale-110"
              style={`background: var(--line-${card.line});`}
            >
              {/* Crisp enamel reflection highlight */}
              <span class="absolute top-0.5 left-0.5 h-1 w-1 rounded-full bg-white opacity-90" />
            </div>
          </div>

          {/* Photo Frame with Clean 1px Ink Border */}
          <div class={`relative w-full overflow-hidden border border-(--ink) bg-(--ground) ${card.aspectClass}`}>
            <img
              src={card.image}
              alt={card.alt}
              width={600}
              height={450}
              class="h-full w-full object-cover"
              style={card.objectPosition ? `object-position: ${card.objectPosition};` : undefined}
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </div>

          {/* Authentic White Polaroid Chin: Borderless enlarged logo + full company title */}
          <div class="pt-2 px-1 flex items-center gap-2 min-w-0">
            <CompanyLogo name={card.company} size={22} class="h-5.5 w-5.5 object-contain shrink-0" />
            <h3 class="text-[14px] sm:text-[15px] font-bold leading-tight text-(--ink) tracking-tight whitespace-nowrap">
              {card.org}
            </h3>
          </div>
        </article>
      ))
    }
  </div>

  {/* Mobile View: Horizontal scrolling snapshot strip (compact ~245px height, responsive) */}
  <div class="sm:hidden flex gap-4 overflow-x-auto pb-5 pt-3 -mx-5 px-5 snap-x scrollbar-none">
    {
      pins.map((card, i) => (
        <article
          class="polaroid-card group relative w-[250px] shrink-0 snap-center bg-white border-2 border-(--ink) p-2 pb-2.5 transition-transform duration-200 cursor-pointer"
          data-index={i}
          data-tilt={card.tilt}
          data-base-z={card.z}
          style={`--card-tilt: ${card.tilt}; z-index: ${card.z};`}
          tabindex="0"
          role="button"
          aria-label={card.org}
        >
          {/* Clean Enameled Pin */}
          <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 z-20 pointer-events-none" aria-hidden="true">
            <div
              class="h-4 w-4 rounded-full border-2 border-(--ink) relative"
              style={`background: var(--line-${card.line});`}
            >
              <span class="absolute top-0.5 left-0.5 h-1 w-1 rounded-full bg-white opacity-90" />
            </div>
          </div>

          {/* Photo Frame */}
          <div class={`relative w-full overflow-hidden border border-(--ink) bg-(--ground) ${card.aspectClass}`}>
            <img
              src={card.image}
              alt={card.alt}
              width={500}
              height={375}
              class="h-full w-full object-cover"
              style={card.objectPosition ? `object-position: ${card.objectPosition};` : undefined}
              loading="lazy"
            />
          </div>

          {/* Chin: Borderless enlarged logo + full company title */}
          <div class="pt-2 px-1 flex items-center gap-2 min-w-0">
            <CompanyLogo name={card.company} size={22} class="h-5.5 w-5.5 object-contain shrink-0" />
            <h3 class="text-[14px] font-bold leading-tight text-(--ink) tracking-tight whitespace-nowrap">
              {card.org}
            </h3>
          </div>
        </article>
      ))
    }
  </div>
</div>

<style>
  /* Subtle organic rotation per card */
  .polaroid-card {
    transform: rotate(var(--card-tilt, 0deg));
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  /* Any hovered or keyboard-focused card INSTANTLY pops in front of all other cards */
  .polaroid-card:hover,
  .polaroid-card:focus-visible {
    transform: rotate(0deg) scale(1.04) !important;
    z-index: 100 !important;
  }

  /* Active clicked state keeps card raised above baseline cards when not hovering another card */
  .polaroid-card.is-active {
    transform: rotate(0deg) scale(1.02);
    z-index: 40 !important;
  }
</style>

<script is:inline>
  (function () {
    const cluster = document.getElementById('experience-cluster');
    if (!cluster) return;

    const cards = Array.from(cluster.querySelectorAll('.polaroid-card'));
    let activeCard = null;

    function activateCard(card) {
      if (activeCard && activeCard !== card) {
        activeCard.classList.remove('is-active');
        activeCard.style.zIndex = activeCard.dataset.baseZ || '';
      }

      if (activeCard === card) {
        card.classList.remove('is-active');
        card.style.zIndex = card.dataset.baseZ || '';
        activeCard = null;
        return;
      }

      card.classList.add('is-active');
      card.style.zIndex = '40';
      activeCard = card;
    }

    cards.forEach((card) => {
      // Hover is handled directly by CSS :hover { z-index: 100 !important }
      // which guarantees instantaneous stacking in front without any delay or counter bugs.
      card.addEventListener('click', (e) => {
        e.stopPropagation();
        activateCard(card);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activateCard(card);
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!cluster.contains(e.target) && activeCard) {
        activeCard.classList.remove('is-active');
        activeCard.style.zIndex = activeCard.dataset.baseZ || '';
        activeCard = null;
      }
    });
  })();
</script>
