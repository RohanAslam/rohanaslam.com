---

<div class="route-map-container my-4">
  <!-- Mobile Advisory Notice (Only displayed on mobile viewports) -->
  <aside class="block md:hidden mb-4 border-2 border-(--ink) bg-(--surface) p-3" aria-label="Viewing recommendation">
    <div class="flex items-start gap-2.5">
      <span class="font-mono text-[13px] font-bold text-(--cobalt) shrink-0 mt-0.5">ℹ</span>
      <div class="font-mono text-[11px] leading-relaxed text-(--ink)">
        <span class="font-bold uppercase tracking-wider block mb-0.5">Desktop Recommended</span>
        For the best viewing experience of this interactive visualization and animated cross-line tracks, please view on desktop.
      </div>
    </div>
  </aside>

  <!-- Unified Top Inspector Card -->
  <div
    id="station-inspector"
    class="mb-6 border-2 border-(--ink) bg-(--ground) transition-all"
    style="--route: var(--line-1)"
  >
    <!-- Header status line -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-(--ink) bg-(--surface) px-4 py-2.5">
      <div class="flex items-center gap-2">
        <span id="inspector-bullet" class="bullet bullet-1 text-[11px] font-bold">Line 1 · Corporate</span>
        <span id="inspector-timeframe" class="font-mono text-[12px] text-(--ink-faint)">Sep 2026 – Present (Full Time)</span>
      </div>

      <!-- Action buttons: Primary link, dual secondary link for connections, and return button -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="inspector-btn-back"
          class="hidden items-center gap-1 px-2.5 py-1 border border-(--ink) bg-(--surface) text-(--ink) font-mono text-[11px] font-bold uppercase transition-colors hover:bg-(--ink) hover:text-(--ground)"
        >
          ← Back
        </button>

        <a
          id="inspector-link"
          href="/work/sunlife-digital-transformation"
          class="inline-flex items-center gap-1.5 px-3 py-1 bg-(--ink) text-(--ground) font-mono text-[11px] font-bold uppercase transition-colors hover:bg-(--cobalt)"
        >
          <span id="inspector-link-text">Read case study</span>
          <span>→</span>
        </a>

        <a
          id="inspector-link-secondary"
          href="#"
          class="hidden items-center gap-1.5 px-3 py-1 border border-(--ink) bg-(--ground) text-(--ink) font-mono text-[11px] font-bold uppercase transition-colors hover:bg-(--cobalt) hover:text-(--ground) hover:border-(--cobalt)"
        >
          <span id="inspector-link-secondary-text">Read target case study</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Inspector Content Body -->
    <div class="p-4 sm:p-5">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <h3 id="inspector-title" class="font-mono text-[18px] sm:text-[21px] font-bold text-(--ink) tracking-tight">
            Sun Life (SunAdvantage)
          </h3>
          <p id="inspector-role" class="text-[14px] font-medium text-(--ink-muted) mt-0.5">
            Strategy & Operations Specialist
          </p>
        </div>

        <!-- Optional Employer Logo -->
        <div id="inspector-logo" class="h-10 w-24 border border-(--ink-faint)/30 bg-(--surface) flex items-center justify-center p-1 shrink-0">
          <img src="/images/logos/sunlife.png" alt="Sun Life" class="logo-img max-h-full max-w-full object-contain" data-logo="sunlife" />
          <img src="/images/logos/otpp.png" alt="OTPP" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="otpp" />
          <img src="/images/logos/dyedurham.png" alt="Dye & Durham" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="dyedurham" />
          <img src="/images/logos/uoft.png" alt="U of T" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="uoft" />
          <img src="/images/logos/rbc.png" alt="RBC" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="rbc" />
          <img src="/images/logos/smartsyllabus.png" alt="SmartSyllabus" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="smartsyllabus" />
        </div>
      </div>

      <!-- Detailed Summary or Connection Explanation -->
      <div class="mt-3 pt-3 border-t border-(--ink-faint)/20">
        <p id="inspector-summary" class="text-[14px] leading-relaxed text-(--ink-muted) max-w-[85ch]">
          Full time strategy and operations on the SunAdvantage group benefits platform, which modernizes health and dental coverage for small and medium businesses. Automated reporting, process discovery, and business transformation.
        </p>

        <!-- Interactive Cross-Line Connection Pills -->
        <div id="inspector-transfers" class="mt-4 pt-3 border-t border-(--ink-faint)/20">
          <div class="label text-[11px] font-bold text-(--ink) mb-2 flex items-center gap-1.5">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-(--cobalt)"></span>
            <span>CROSS-LINE CONNECTIONS · TAP TO EXPLORE RELATION:</span>
          </div>
          <div id="inspector-transfers-list" class="flex flex-wrap gap-2">
            <!-- Populated dynamically via JS -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile View Switcher: Line Directory vs Track Map -->
  <div class="block md:hidden mb-4">
    <div class="flex items-center justify-between gap-3 border-2 border-(--ink) bg-(--ground) p-2 mb-2.5">
      <div class="label text-[11px] font-bold text-(--ink) flex items-center gap-1.5">
        <span class="inline-block h-2 w-2 rounded-full bg-(--cobalt)"></span>
        <span>MOBILE VIEW</span>
      </div>
      <div class="flex items-center gap-1">
        <button
          type="button"
          id="mobile-view-list"
          class="mobile-view-tab active px-2.5 py-1 text-[11px] font-mono font-bold uppercase transition-colors"
        >
          Station Directory
        </button>
        <button
          type="button"
          id="mobile-view-map"
          class="mobile-view-tab px-2.5 py-1 text-[11px] font-mono font-bold uppercase transition-colors"
        >
          Pan Track Map
        </button>
      </div>
    </div>

    <!-- Mobile quick jump pills -->
    <div id="mobile-quick-stations" class="overflow-x-auto pb-1 flex items-center gap-2 text-[12px]">
      <span class="label text-[11px] text-(--ink-faint) shrink-0 uppercase">Jump:</span>
      {
        [
          { id: 'sunadvantage', name: 'Sun Life' },
          { id: 'smartsyllabus', name: 'SmartSyllabus' },
          { id: 'flingblade', name: 'Flingblade' },
          { id: 'personal-ai-os', name: 'AI OS' },
          { id: 'job-portal', name: 'Job Portal' },
          { id: 'otpp', name: 'OTPP' },
          { id: 'uoft', name: 'U of T' },
        ].map((s) => (
          <button
            type="button"
            class="mobile-station-chip shrink-0 px-2.5 py-1 border border-(--ink) bg-(--surface) text-(--ink) text-[11px] font-mono font-bold uppercase transition-colors hover:bg-(--cobalt) hover:text-(--ground) hover:border-(--cobalt)"
            data-target-station={s.id}
          >
            {s.name}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Mobile Vertical Station Directory View (Default on mobile for maximum readability) -->
  <div id="mobile-station-list-view" class="block md:hidden border-2 border-(--ink) bg-(--ground) mb-6">
    <div class="bg-[#0B0E12] px-3.5 py-2 text-[#F2B705] font-mono text-[11px] font-bold tracking-wider uppercase flex items-center justify-between">
      <span>ROUTE DIRECTORY · TAP STATION TO INSPECT</span>
      <span>5 ROUTES</span>
    </div>
    <div class="divide-y-2 divide-(--ink)">
      {
        [1, 2, 3, 4, 5].map((lineNum) => {
          const lineStations = stations.filter((s) => s.line === lineNum);
          return (
            <div class="p-3">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span
                  class="font-mono text-[11px] font-bold px-2 py-0.5"
                  style={`background: ${routeColors[lineNum]}; color: ${routeTextColors[lineNum]}`}
                >
                  {lineNames[lineNum]}
