      {
        [
          { id: 'sunadvantage', name: 'Sun Life' },
          { id: 'smartsyllabus', name: 'SmartSyllabus' },
          { id: 'otpp', name: 'OTPP' },
          { id: 'dyedurham', name: 'Dye & Durham' },
          { id: 'uoft', name: 'U of T' },
          { id: 'personal-ai-os', name: 'AI OS' },
          { id: 'bikeshare', name: 'Bikeshare' },
        ].map((s) => (
          <button
            type="button"
            class="mobile-station-chip shrink-0 px-2.5 py-1 border border-(--ink) bg-(--surface) text-(--ink) text-[11px] font-mono font-bold uppercase transition-colors hover:bg-(--cobalt) hover:text-(--ground) hover:border-(--cobalt)"
            data-target-station={s.id}
          >
            {s.name}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Mobile Vertical Station List View -->
  <div id="mobile-station-list-view" class="hidden md:hidden border-2 border-(--ink) bg-(--ground) mb-6">
    <div class="bg-[#0B0E12] px-3.5 py-2 text-[#F2B705] font-mono text-[11px] font-bold tracking-wider uppercase flex items-center justify-between">
      <span>STATION DIRECTORY · TAP TO INSPECT</span>
      <span>5 ROUTES</span>
    </div>
    <div class="divide-y-2 divide-(--ink)">
      {
        [1, 2, 3, 4, 5].map((lineNum) => {
          const lineStations = stations.filter((s) => s.line === lineNum);
          return (
            <div class="p-3">
              <div class="flex items-center gap-2 mb-2">
                <span class={`bullet bullet-${lineNum} text-[11px] font-bold`}>
                  {lineNames[lineNum]}
                </span>
                <span class="label text-[11px] text-(--ink-faint)">{lineStations.length} stops</span>
              </div>
              <div class="grid grid-cols-1 gap-1.5 pl-2 border-l-2" style={`border-color: ${routeColors[lineNum]}`}>
                {lineStations.map((s) => (
                  <button
                    type="button"
                    class="mobile-list-station-btn text-left p-2 transition-colors hover:bg-(--surface) flex items-center justify-between gap-3"
                    data-station-id={s.id}
                  >
                    <div class="min-w-0">
                      <div class="font-mono text-[13px] font-bold text-(--ink) truncate">{s.label}</div>
                      <div class="text-[12px] text-(--ink-muted) truncate">{s.organization}</div>
                    </div>
                    <div class="font-mono text-[11px] text-(--ink-faint) shrink-0">{s.timeframe.split('–')[0].trim()}</div>
                  </button>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <div id="mobile-pan-hint" class="block md:hidden text-center py-2 bg-(--surface) border-t-2 border-b-2 border-(--ink) font-mono text-[11px] font-bold text-(--ink) uppercase tracking-wide mb-2">
    ⇄ Pan track horizontally to explore stations
  </div>

  <figure id="route-map-figure" class="my-0 overflow-x-auto" aria-label="Career transit route diagram">
    <svg viewBox="0 0 1240 800" class="w-full min-w-[1040px] select-none" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Line 5 · earlier work. Enters from the left edge, terminates at 780. -->
      <path
        d={`M 0 ${EARLY_ROW_Y} H ${EARLY_END_X}`}
        stroke="var(--line-5)" stroke-width="10" stroke-linecap="butt"
        class="route-line"
        style={`--len:${EARLY_LEN}; animation-delay:0ms; animation-duration:${EARLY_DUR}ms`}
      />
      <!-- Line 4 · data, branches down at 45 from x=150 -->
      <path
        d={`M ${DATA_JUNCTION_X} 310 L ${DATA_BEND_X} ${DATA_ROW_Y} H ${LINE_END_X}`}
        stroke="var(--line-4)" stroke-width="10" stroke-linecap="butt" stroke-linejoin="miter"
        class="route-line"
        style={`--len:${DATA_LEN}; animation-delay:${DATA_START}ms; animation-duration:${DATA_DUR}ms`}
      />
      <!-- Line 1 · strategy -->
      <path
        d="M 0 310 H 1240"
        stroke="var(--line-1)" stroke-width="10" stroke-linecap="butt"
        class="route-line"
        style={`--len:${MAIN_LEN}; animation-delay:0ms; animation-duration:${MAIN_DUR}ms`}
      />
      <!-- Line 3 · startup, branches up at 45 -->
      <path
        d="M 790 310 L 950 150 H 1240"
        stroke="var(--line-3)" stroke-width="10" stroke-linecap="butt" stroke-linejoin="miter"
        class="route-line"
        style={`--len:${BRANCH_LEN}; animation-delay:${BRANCH_START}ms; animation-duration:${BRANCH_DUR}ms`}
      />
      <!-- Line 2 · ai tools, branches down at 45 -->
      <path
        d="M 790 310 L 950 470 H 1240"
        stroke="var(--line-2)" stroke-width="10" stroke-linecap="butt" stroke-linejoin="miter"
        class="route-line"
        style={`--len:${BRANCH_LEN}; animation-delay:${BRANCH_START}ms; animation-duration:${BRANCH_DUR}ms`}
      />

      <!-- Stations: node on the line, clean transparent logo, name, and year stacked cleanly with no overlap -->
      {
        stations.map((s) => {
          const labelY = s.side === 'above' ? s.y - 46 : s.y + 50;
          const subY = s.side === 'above' ? s.y - 68 : s.y + 72;
          const logoY = s.side === 'above' ? s.y - 144 : s.y + 88;
          return (
            <g
              class="station-hit cursor-pointer"
              data-station-id={s.id}
              tabindex="0"
              role="button"
              aria-label={`Station: ${s.label}, ${s.organization}`}
            >
              {/* Station Node on Track: Enlarge touch target + node ring + center dot */}
              <g class="route-station" style={`animation-delay:${s.delay}ms; transform-origin:${s.x}px ${s.y}px`}>
                <circle cx={s.x} cy={s.y} r="28" fill="transparent" class="node-hit-pad" />
                <circle cx={s.x} cy={s.y} r="14" fill="var(--ground)" stroke={routeColors[s.line]} stroke-width="7" class="node-ring" />
                <circle cx={s.x} cy={s.y} r="5" fill="var(--ink)" class="node-center-dot" />
              </g>

              {/* Company logo, employers only. Project stations skip it entirely. */}
              {s.company && (
                <image
                  href={`/images/logos/${s.company}.png`}
                  x={s.x - LOGO_W / 2}
                  y={logoY}
                  width={LOGO_W}
                  height={LOGO_H}
                  preserveAspectRatio="xMidYMid meet"
                  class="route-label pointer-events-none"
                  style={`animation-delay:${s.delay + 150}ms`}
                />
              )}

              {/* Station Name Label */}
              <text
                x={s.x}
                y={labelY}
                class="route-label pointer-events-none"
                style={`animation-delay:${s.delay + 220}ms`}
                text-anchor="middle"
                fill="var(--ink)"
                font-family="var(--font-mono)"
                font-size="14"
                font-weight="700"
                letter-spacing="0.8"
              >
                {s.label}
              </text>

              {/* Station Sub / Year Label (Uniform neutral ink-faint color for all stations) */}
              <text
                x={s.x}
                y={subY}
                class="route-label pointer-events-none"
                style={`animation-delay:${s.delay + 290}ms`}
                text-anchor="middle"
                fill="var(--ink-faint)"
                font-family="var(--font-mono)"
                font-size="12"
                font-weight="600"
                letter-spacing="1"
              >
                {s.sub}
              </text>
            </g>
          );
        })
      }
    </svg>
  </figure>
</div>

<style>
  /* Hover and active station node styles */
  .station-hit {
    outline: none;
  }
  .station-hit .node-ring {
    transition: stroke var(--dur-micro) var(--ease), stroke-width var(--dur-micro) var(--ease);
  }
  .station-hit:hover .node-ring,
  .station-hit:focus-visible .node-ring {
    stroke: var(--cobalt);
  }

  /* Solid black center dot inside current station ring at all times */
  .station-hit .node-center-dot {
    opacity: 0;
    transition: opacity var(--dur-micro) var(--ease), transform var(--dur-micro) var(--ease);
    transform-origin: center;
    transform-box: fill-box;
    transform: scale(0.4);
  }
  .station-hit.current-station .node-center-dot {
    opacity: 1;
    transform: scale(1);
  }
  .station-hit.current-station .node-ring {
    stroke: var(--cobalt) !important;
    stroke-width: 8px;
  }

  /* TTC arrival sign container and sliding animations */
  .ttc-slide-in {
    animation: ttcSlideIn 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .ttc-slide-out {
    animation: ttcSlideOut 200ms cubic-bezier(0.7, 0, 0.84, 0) forwards;
  }
  .ttc-slide-prep-left {
    transform: translateX(-100%) !important;
    opacity: 0 !important;
    animation: none !important;
  }

  @keyframes ttcSlideIn {
    0% {
      transform: translateX(-100%);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes ttcSlideOut {
    0% {
      transform: translateX(0);
      opacity: 1;
    }
    100% {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ttc-slide-in,
    .ttc-slide-out {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }

  @media (prefers-color-scheme: dark) {
    #ttc-sign-container {
      background: #0D1014;
      border-color: #FFC933;
      color: #FFC933;
    }
    #ttc-sign-container span,
    #ttc-sign-container div {
      color: #FFC933;
    }
  }

  .mobile-view-tab {
    border: 2px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
  }
  .mobile-view-tab.active {
    background: var(--ink);
    color: var(--ground);
  }
  .mobile-list-station-btn:focus-visible {
    outline: 3px solid var(--cobalt);
    outline-offset: 2px;
  }
</style>

<script is:inline define:vars={{ stations }}>
  const dataMap = {};
  stations.forEach((s) => {
    dataMap[s.id] = s;
  });

  const inspector = document.getElementById('station-inspector');
  const elTitle = document.getElementById('inspector-title');
  const elRole = document.getElementById('inspector-role');
  const elSummary = document.getElementById('inspector-summary');
  const elTimeframe = document.getElementById('inspector-timeframe');
  const elBullet = document.getElementById('inspector-bullet');
  const elLink = document.getElementById('inspector-link');
  const elLinkText = document.getElementById('inspector-link-text');
  const elStatusText = document.getElementById('ttc-status-text');
  const signTrack = document.getElementById('ttc-sign-track');
  const btnToggle = document.getElementById('inspector-toggle-details');
  const drawerSummary = document.getElementById('inspector-summary-drawer');
  const logoImgs = document.querySelectorAll('.logo-img');
  const nodes = document.querySelectorAll('.station-hit');

  let currentId = 'sunadvantage';
  let slideTimeout = null;
  let arrivedTimeout = null;

  // Toggle summary drawer
  if (btnToggle && drawerSummary) {
    btnToggle.addEventListener('click', () => {
      const isHidden = drawerSummary.classList.contains('hidden');
      if (isHidden) {
        drawerSummary.classList.remove('hidden');
        btnToggle.setAttribute('aria-expanded', 'true');
      } else {
        drawerSummary.classList.add('hidden');
        btnToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  function updateInspector(stationId) {
    const s = dataMap[stationId];
    if (!s) return;

    // Update route color styling on inspector card
    const routeVar = `var(--line-${s.line})`;
    if (inspector) {
      inspector.style.setProperty('--route', routeVar);
    }

    // Update text
    if (elTitle) elTitle.textContent = `${s.organization}`;
    if (elRole) elRole.textContent = s.role;
    if (elSummary) elSummary.textContent = s.summary;
    if (elTimeframe) elTimeframe.textContent = s.timeframe;

    // Update bullet
    if (elBullet) {
      elBullet.className = `bullet bullet-${s.line} text-[11px] font-bold`;
      elBullet.textContent = s.routeName;
    }

    // Update logo. Project stations carry no company, so the whole box goes away.
    const logoBox = document.getElementById('inspector-logo');
    if (logoBox) logoBox.classList.toggle('hidden', !s.company);
    logoImgs.forEach((img) => {
      if (s.company && img.getAttribute('data-logo') === s.company) {
        img.classList.remove('hidden');
      } else {
        img.classList.add('hidden');
      }
    });

    // Update link
    if (elLink && elLinkText) {
      if (s.link) {
        elLink.style.display = 'inline-flex';
        elLink.setAttribute('href', s.link);
        if (s.link.startsWith('http')) {
          elLink.setAttribute('target', '_blank');
          elLink.setAttribute('rel', 'noopener noreferrer');
        } else {
          elLink.removeAttribute('target');
          elLink.removeAttribute('rel');
        }
        elLinkText.textContent = s.linkLabel || 'Read case study';
      } else {
        elLink.style.display = 'none';
      }
    }
  }

  function triggerArrivalTransition() {
    if (!signTrack) return;

    if (slideTimeout) clearTimeout(slideTimeout);
    if (arrivedTimeout) clearTimeout(arrivedTimeout);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (elStatusText) elStatusText.textContent = 'ARRIVED AT';
      return;
    }

    // Slide out to the right
    signTrack.classList.remove('ttc-slide-in', 'ttc-slide-prep-left');
    signTrack.classList.add('ttc-slide-out');

    slideTimeout = setTimeout(() => {
      if (elStatusText) elStatusText.textContent = 'ARRIVING AT';

      // Position instantly off-screen to the left
      signTrack.classList.remove('ttc-slide-out');
      signTrack.classList.add('ttc-slide-prep-left');

      // Force layout reflow
      void signTrack.offsetWidth;

      // Slide in left to right
      signTrack.classList.remove('ttc-slide-prep-left');
      signTrack.classList.add('ttc-slide-in');

      // Transition to 'ARRIVED AT' once arrival has completed
      arrivedTimeout = setTimeout(() => {
        if (elStatusText) {
          elStatusText.textContent = 'ARRIVED AT';
        }
      }, 650);
    }, 200);
  }

  function setCurrent(stationId) {
    const s = dataMap[stationId];
    if (!s) return;
    currentId = stationId;

    nodes.forEach((n) => {
      n.classList.toggle('current-station', n.getAttribute('data-station-id') === stationId);
    });

    // Auto center station on mobile in figure if in map view
    const figure = document.getElementById('route-map-figure');
    if (figure && window.innerWidth < 768) {
      const scale = figure.scrollWidth / 1240;
      const targetScrollLeft = (s.x * scale) - (figure.clientWidth / 2);
      figure.scrollTo({ left: Math.max(0, targetScrollLeft), behavior: 'smooth' });
    }

    triggerArrivalTransition();
    updateInspector(stationId);
  }

  // Click, tap, focus or Enter on a station makes it the current station
  nodes.forEach((n) => {
    const sid = n.getAttribute('data-station-id');
    if (!sid) return;
    n.addEventListener('focus', () => setCurrent(sid));
    n.addEventListener('click', () => setCurrent(sid));
    n.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setCurrent(sid);
      }
    });
  });

  // Mobile View Switcher (Map vs List)
  const btnMap = document.getElementById('mobile-view-map');
  const btnList = document.getElementById('mobile-view-list');
  const mapView = document.getElementById('route-map-figure');
  const listView = document.getElementById('mobile-station-list-view');
  const quickStations = document.getElementById('mobile-quick-stations');
  const panHint = document.getElementById('mobile-pan-hint');

  if (btnMap && btnList && mapView && listView) {
    btnMap.addEventListener('click', () => {
      btnMap.classList.add('active');
      btnList.classList.remove('active');
      mapView.classList.remove('hidden');
      if (quickStations) quickStations.classList.remove('hidden');
      if (panHint) panHint.classList.remove('hidden');
      listView.classList.add('hidden');
    });

    btnList.addEventListener('click', () => {
      btnList.classList.add('active');
      btnMap.classList.remove('active');
      mapView.classList.add('hidden');
      if (quickStations) quickStations.classList.add('hidden');
      if (panHint) panHint.classList.add('hidden');
      listView.classList.remove('hidden');
    });
  }

  // Mobile quick chips & mobile list buttons
  document.querySelectorAll('[data-target-station]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const sid = chip.getAttribute('data-target-station');
      if (sid) setCurrent(sid);
    });
  });

  document.querySelectorAll('.mobile-list-station-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sid = btn.getAttribute('data-station-id');
      if (sid) {
        setCurrent(sid);
        if (inspector) {
          inspector.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }
    });
  });

  // Default current station: SunAdvantage
  setCurrent('sunadvantage');
</script>
