 */

const DRAW_SPEED = 1.2; // px per ms
const TRACK_START_X = 150;
const TRACK_END_X = 1220;
const TRACK_LEN = TRACK_END_X - TRACK_START_X;
const TRACK_DUR = Math.round(TRACK_LEN / DRAW_SPEED);

const calcDelay = (x: number) => Math.round(((x - TRACK_START_X) / TRACK_LEN) * 600);

const LOGO_W = 100;
