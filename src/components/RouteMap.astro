---

<div class="route-map-container my-4">
  <!-- Unified Top Transit Board & Station Inspector -->
  <div
    id="station-inspector"
    class="mb-6 border-2 border-(--ink) bg-(--ground) transition-all"
    style="--route: var(--line-1)"
  >
    <!-- TTC Arrival Sign Header -->
    <div
      id="ttc-sign-container"
      class="overflow-hidden border-b-2 border-(--ink) bg-[#0B0E12] px-4 py-2 text-[#F2B705] transition-all"
    >
      <div id="ttc-sign-track" class="flex items-center gap-2 font-mono text-[12px] font-bold tracking-widest uppercase ttc-slide-in">
        <span id="ttc-status-pulse" class="inline-block h-2 w-2 rounded-full bg-[#F2B705]"></span>
        <span id="ttc-sign-status">ARRIVING AT</span>
        <span class="text-[#F2B705]/60">:</span>
        <span id="ttc-sign-station">SUN LIFE (SUNADVANTAGE)</span>
        <span class="text-[#F2B705]/40 ml-2 hidden md:inline" id="ttc-interchange-badge">⇄ HOVER STATIONS TO VIEW CONNECTIONS</span>
      </div>
    </div>

    <!-- Inspector Content Grid -->
    <div class="p-4 sm:p-5">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span id="inspector-bullet" class="bullet bullet-1 text-[11px] font-bold">Line 1 · Corporate & Strategy</span>
            <span id="inspector-timeframe" class="font-mono text-[12px] text-(--ink-faint)">Sep 2026 – Present (Full Time)</span>
          </div>
          <h3 id="inspector-title" class="font-mono text-[18px] sm:text-[20px] font-bold text-(--ink) tracking-tight">
            Sun Life (SunAdvantage)
          </h3>
          <p id="inspector-role" class="text-[14px] font-medium text-(--ink-muted) mt-0.5">
            Strategy & Operations Specialist
          </p>
        </div>

        <!-- Action / Case study link & Employer Logo -->
        <div class="flex items-center gap-3 shrink-0">
          <div id="inspector-logo" class="h-10 w-24 border border-(--ink-faint)/30 bg-(--surface) flex items-center justify-center p-1">
            <img src="/images/logos/sunlife.png" alt="Sun Life" class="logo-img max-h-full max-w-full object-contain" data-logo="sunlife" />
            <img src="/images/logos/otpp.png" alt="OTPP" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="otpp" />
            <img src="/images/logos/dyedurham.png" alt="Dye & Durham" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="dyedurham" />
            <img src="/images/logos/uoft.png" alt="U of T" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="uoft" />
            <img src="/images/logos/rbc.png" alt="RBC" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="rbc" />
            <img src="/images/logos/smartsyllabus.png" alt="SmartSyllabus" class="logo-img max-h-full max-w-full object-contain hidden" data-logo="smartsyllabus" />
          </div>

          <a
            id="inspector-link"
            href="/work/sunlife-digital-transformation"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-(--ink) text-(--ground) font-mono text-[12px] font-bold uppercase transition-colors hover:bg-(--cobalt)"
          >
            <span id="inspector-link-text">Read case study</span>
            <span>→</span>
          </a>

          <button
            type="button"
            id="inspector-toggle-details"
            class="px-2.5 py-1.5 border border-(--ink) font-mono text-[11px] text-(--ink-muted) hover:text-(--ink) hover:border-(--cobalt) transition-colors"
            aria-expanded="true"
            title="Toggle notes"
          >
            NOTES
          </button>
        </div>
      </div>

      <!-- Collapsible Detailed Summary & Transfer Relationship drawer -->
      <div id="inspector-summary-drawer" class="mt-3 pt-3 border-t border-(--ink-faint)/20">
        <p id="inspector-summary" class="text-[14px] leading-relaxed text-(--ink-muted) max-w-[85ch]">
          Full time strategy and operations on the SunAdvantage group benefits platform, which modernizes health and dental coverage for small and medium businesses. Automated reporting, process discovery, and business transformation.
        </p>
        <div id="inspector-transfers" class="mt-2 text-[12px] font-mono text-(--ink-faint) flex flex-wrap items-center gap-2 hidden">
          <span class="font-bold text-(--ink)">CROSS-LINE CONNECTIONS:</span>
          <span id="inspector-transfers-list">None</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile View Switcher: Map View vs Station List View -->
  <div class="block md:hidden mb-4">
    <div class="flex items-center justify-between gap-3 border-2 border-(--ink) bg-(--ground) p-2 mb-2.5">
      <div class="label text-[11px] font-bold text-(--ink) flex items-center gap-1.5">
        <span class="inline-block h-2 w-2 rounded-full bg-(--cobalt)"></span>
        <span>TRANSIT VIEW</span>
      </div>
      <div class="flex items-center gap-1">
        <button
          type="button"
          id="mobile-view-map"
          class="mobile-view-tab active px-2.5 py-1 text-[11px] font-mono font-bold uppercase transition-colors"
        >
          Track Map
        </button>
        <button
          type="button"
          id="mobile-view-list"
          class="mobile-view-tab px-2.5 py-1 text-[11px] font-mono font-bold uppercase transition-colors"
        >
          Station List
        </button>
      </div>
    </div>

    <!-- Mobile quick jump pills (Map Mode) -->
    <div id="mobile-quick-stations" class="overflow-x-auto pb-1 flex items-center gap-2 text-[12px]">
      <span class="label text-[11px] text-(--ink-faint) shrink-0 uppercase">Jump:</span>
      {
        [
          { id: 'sunadvantage', name: 'Sun Life' },
          { id: 'smartsyllabus', name: 'SmartSyllabus' },
          { id: 'flingblade', name: 'Flingblade' },
          { id: 'personal-ai-os', name: 'AI OS' },
          { id: 'job-portal', name: 'Job Portal' },
          { id: 'otpp', name: 'OTPP' },
          { id: 'uoft', name: 'U of T' },
        ].map((s) => (
          <button
            type="button"
            class="mobile-station-chip shrink-0 px-2.5 py-1 border border-(--ink) bg-(--surface) text-(--ink) text-[11px] font-mono font-bold uppercase transition-colors hover:bg-(--cobalt) hover:text-(--ground) hover:border-(--cobalt)"
            data-target-station={s.id}
          >
            {s.name}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Mobile Vertical Station List View -->
  <div id="mobile-station-list-view" class="hidden md:hidden border-2 border-(--ink) bg-(--ground) mb-6">
    <div class="bg-[#0B0E12] px-3.5 py-2 text-[#F2B705] font-mono text-[11px] font-bold tracking-wider uppercase flex items-center justify-between">
      <span>STATION DIRECTORY · TAP TO INSPECT</span>
      <span>5 ROUTES</span>
    </div>
    <div class="divide-y-2 divide-(--ink)">
      {
        [1, 2, 3, 4, 5].map((lineNum) => {
          const lineStations = stations.filter((s) => s.line === lineNum);
          return (
            <div class="p-3">
              <div class="flex items-center gap-2 mb-2">
                <span
                  class="font-mono text-[11px] font-bold px-2 py-0.5"
                  style={`background: ${routeColors[lineNum]}; color: ${routeTextColors[lineNum]}`}
                >
                  {lineNames[lineNum]}
                </span>
                <span class="label text-[11px] text-(--ink-faint)">{lineStations.length} stops</span>
              </div>
              <div class="grid grid-cols-1 gap-1.5 pl-2 border-l-2" style={`border-color: ${routeColors[lineNum]}`}>
                {lineStations.map((s) => (
                  <button
                    type="button"
                    class="mobile-list-station-btn text-left p-2 transition-colors hover:bg-(--surface) flex items-center justify-between gap-3"
                    data-station-id={s.id}
                  >
                    <div class="min-w-0">
                      <div class="font-mono text-[13px] font-bold text-(--ink) truncate">{s.label}</div>
                      <div class="text-[12px] text-(--ink-muted) truncate">{s.organization}</div>
                    </div>
                    <div class="font-mono text-[11px] text-(--ink-faint) shrink-0">{s.timeframe.split('–')[0].trim()}</div>
                  </button>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <div id="mobile-pan-hint" class="block md:hidden text-center py-2 bg-(--surface) border-t-2 border-b-2 border-(--ink) font-mono text-[11px] font-bold text-(--ink) uppercase tracking-wide mb-2">
    ⇄ Pan track horizontally to explore stations
  </div>

  <!-- SVG Route Diagram: 5 Parallel Isolated Lines + Dynamic Cross-Line Connections -->
  <figure id="route-map-figure" class="my-0 overflow-x-auto" aria-label="Career transit route diagram">
    <svg viewBox="0 0 1260 870" class="w-full min-w-[1060px] select-none" fill="none" xmlns="http://www.w3.org/2000/svg">
      {/* 5 Isolated Horizontal Routes */}
      {
        lineTracks.map((line) => (
          <g class="route-track-group">
            {/* Left Terminal Route Badge */}
            <rect
              x="20"
              y={line.y - 15}
              width="125"
              height="30"
              fill={routeColors[line.num]}
            />
            <text
              x="82"
              y={line.y + 5}
              text-anchor="middle"
              fill={routeTextColors[line.num]}
              font-family="var(--font-mono)"
              font-size="11"
              font-weight="700"
              letter-spacing="0.5"
            >
              {line.name}
            </text>

            {/* Horizontal Track Line */}
            <path
              d={`M ${TRACK_START_X} ${line.y} H ${TRACK_END_X}`}
              stroke={routeColors[line.num]}
              stroke-width="8"
              stroke-linecap="square"
              class="route-line"
              style={`--len:${TRACK_LEN}; animation-delay:0ms; animation-duration:${TRACK_DUR}ms`}
            />
          </g>
        ))
      }

      {/* Dynamic Cross-Line Connections Layer (Rendered underneath station nodes) */}
      <g id="cross-connections-layer" class="pointer-events-none"></g>

      {/* Stations: node on the line, clean transparent logo, name, and year stacked cleanly with no overlap */}
      {
        stations.map((s) => {
          return (
            <g
              class="station-hit cursor-pointer"
              data-station-id={s.id}
              tabindex="0"
              role="button"
              aria-label={`Station: ${s.label}, ${s.organization}`}
            >
              {/* Station Node on Track */}
              <g class="route-station" style={`animation-delay:${s.delay}ms; transform-origin:${s.x}px ${s.y}px`}>
                <circle cx={s.x} cy={s.y} r="28" fill="transparent" class="node-hit-pad" />
                <circle cx={s.x} cy={s.y} r="20" fill="none" stroke={routeColors[s.line]} stroke-width="2" class="node-pulse-ring opacity-0 pointer-events-none" />
                <circle cx={s.x} cy={s.y} r="13" fill="var(--ground)" stroke={routeColors[s.line]} stroke-width="6" class="node-ring" />
                <circle cx={s.x} cy={s.y} r="4.5" fill="var(--ink)" class="node-center-dot" />
              </g>

              {/* Station Name Label */}
              <text
                x={s.x}
                y={s.y - 38}
                class="route-label pointer-events-none"
                style={`animation-delay:${s.delay + 180}ms`}
                text-anchor="middle"
                fill="var(--ink)"
                font-family="var(--font-mono)"
                font-size="13"
                font-weight="700"
                letter-spacing="0.5"
              >
                {s.label}
              </text>

              {/* Station Sub / Year Label */}
              <text
                x={s.x}
                y={s.y - 20}
                class="route-label pointer-events-none"
                style={`animation-delay:${s.delay + 240}ms`}
                text-anchor="middle"
                fill="var(--ink-faint)"
                font-family="var(--font-mono)"
                font-size="11"
                font-weight="600"
                letter-spacing="0.8"
              >
                {s.sub}
              </text>

              {/* Company logo (if present, placed below track) */}
              {s.company && (
                <image
                  href={`/images/logos/${s.company}.png`}
                  x={s.x - LOGO_W / 2}
                  y={s.y + 16}
                  width={LOGO_W}
                  height={LOGO_H}
                  preserveAspectRatio="xMidYMid meet"
                  class="route-label pointer-events-none"
                  style={`animation-delay:${s.delay + 280}ms`}
                />
              )}
            </g>
          );
        })
      }
    </svg>
  </figure>
</div>

<style>
  /* Station Hit & Ring Hover */
  .station-hit {
    outline: none;
  }
  .station-hit .node-ring {
    transition: stroke var(--dur-micro) var(--ease), stroke-width var(--dur-micro) var(--ease);
  }
  .station-hit:hover .node-ring,
  .station-hit:focus-visible .node-ring {
    stroke: var(--cobalt) !important;
  }

  /* Solid black center dot inside current station ring */
  .station-hit .node-center-dot {
    opacity: 0;
    transition: opacity var(--dur-micro) var(--ease), transform var(--dur-micro) var(--ease);
    transform-origin: center;
    transform-box: fill-box;
    transform: scale(0.4);
  }
  .station-hit.current-station .node-center-dot {
    opacity: 1;
    transform: scale(1);
  }
  .station-hit.current-station .node-ring {
    stroke: var(--cobalt) !important;
    stroke-width: 8px;
  }

  /* Cross-Line Connections: Dynamic Target Node Pulse */
  .station-hit.connected-target .node-ring {
    stroke: var(--cobalt) !important;
    stroke-width: 7px !important;
  }
  .station-hit.connected-target .node-pulse-ring {
    opacity: 1 !important;
    stroke: var(--cobalt) !important;
    animation: targetNodePulse 1.4s ease-in-out infinite;
  }
  @keyframes targetNodePulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.35);
      opacity: 0.4;
    }
  }

  /* Cross-Line Connection SVG Path: Animated Dash Flow */
  :global(.connection-line-path) {
    animation: connectionDashFlow 1s linear infinite;
    opacity: 0.95;
    transition: opacity 200ms ease;
  }
  @keyframes connectionDashFlow {
    to {
      stroke-dashoffset: -20;
    }
  }

  /* TTC arrival sign container and sliding animations */
  .ttc-slide-in {
    animation: ttcSlideIn 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .ttc-slide-out {
    animation: ttcSlideOut 200ms cubic-bezier(0.7, 0, 0.84, 0) forwards;
  }
  .ttc-slide-prep-left {
    transform: translateX(-100%) !important;
    opacity: 0 !important;
    animation: none !important;
  }

  @keyframes ttcSlideIn {
    0% {
      transform: translateX(-100%);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes ttcSlideOut {
    0% {
      transform: translateX(0);
      opacity: 1;
    }
    100% {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ttc-slide-in,
    .ttc-slide-out,
    :global(.connection-line-path) {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }

  @media (prefers-color-scheme: dark) {
    #ttc-sign-container {
      background: #0D1014;
      border-color: #FFC933;
      color: #FFC933;
    }
    #ttc-sign-container span,
    #ttc-sign-container div {
      color: #FFC933;
    }
  }

  .mobile-view-tab {
    border: 2px solid var(--ink);
    background: var(--surface);
    color: var(--ink-muted);
  }
  .mobile-view-tab.active {
    background: var(--ink);
    color: var(--ground);
    border-color: var(--ink);
  }
</style>

<script is:inline define:vars={{ stations, routeColors, lineNames }}>
  const dataMap = {};
  stations.forEach((s) => {
    dataMap[s.id] = s;
  });

  // Cross-line curated connections graph
  const CONNECTIONS = {
    'flingblade': [
      { target: 'early-web', reason: 'First browser builds' },
      { target: 'smartqueue', reason: 'Interactive constraints' },
      { target: 'visual-design', reason: '3D mechanics' }
    ],
    'smartsyllabus': [
      { target: 'uoft', reason: 'Born out of U of T student research' },
      { target: 'rag-assistant', reason: 'Document parsing & LLM retrieval' },
      { target: 'smartqueue', reason: 'Student workflow tools' },
      { target: 'kronos', reason: 'Transformer models' }
    ],
    'sunadvantage': [
      { target: 'job-search', reason: 'Process automation & scripts' },
      { target: 'dyedurham', reason: 'Enterprise transformation' },
      { target: 'otpp', reason: 'Institutional systems' }
    ],
    'otpp': [
      { target: 'assistive', reason: 'AODA & WCAG accessibility systems' },
      { target: 'dyedurham', reason: 'Regulated compliance constraints' },
      { target: 'uoft', reason: 'Design research & service mapping' }
    ],
    'job-portal': [
      { target: 'job-search', reason: 'Ingestion pipeline to local UI' },
      { target: 'kronos', reason: 'Local LLM benchmark scoring' },
      { target: 'aurum', reason: 'Local-first desktop architecture' }
    ],
    'aurum': [
      { target: 'bikeshare', reason: 'Tabular aggregation & modeling' },
      { target: 'kronos', reason: 'Financial modeling' },
      { target: 'moneyball', reason: 'Data visualization' }
    ],
    'personal-ai-os': [
      { target: 'second-brain', reason: 'Automated cognitive synthesis' },
      { target: 'job-search', reason: 'n8n workflow pipelines' },
      { target: 'sunadvantage', reason: 'Enterprise to personal automations' }
    ],
    'juventus': [
      { target: 'editorial', reason: 'Typography & layout rules' },
      { target: 'smartqueue', reason: 'Design system rulebooks' }
    ],
    'editorial': [
      { target: 'visual-design', reason: 'Print craft & hierarchy' },
      { target: 'juventus', reason: 'Brand & visual rules' }
    ],
    'moneyball': [
      { target: 'bikeshare', reason: 'R & regression analysis' },
      { target: 'aurum', reason: 'Tabular data analysis' }
    ],
    'bikeshare': [
      { target: 'moneyball', reason: 'Statistical storytelling' },
      { target: 'aurum', reason: 'Residual modeling' }
    ],
    'smartqueue': [
      { target: 'juventus', reason: 'Design system rulebooks' },
      { target: 'smartsyllabus', reason: 'Student productivity' },
      { target: 'flingblade', reason: 'First interactive shipping' }
    ],
    'assistive': [
      { target: 'otpp', reason: 'Enterprise accessibility' },
      { target: 'smartqueue', reason: 'Accessible UI standards' }
    ],
    'dyedurham': [
      { target: 'sunadvantage', reason: 'Financial enterprise products' },
      { target: 'otpp', reason: 'Regulated workflows' }
    ],
    'uoft': [
      { target: 'smartsyllabus', reason: 'Student experience research' },
      { target: 'otpp', reason: 'User journey mapping' }
    ],
    'early-web': [
      { target: 'flingblade', reason: 'Browser WebGL deployment' },
      { target: 'smartqueue', reason: 'Early React reps' }
    ],
    'kronos': [
      { target: 'smartsyllabus', reason: 'Transformer models' },
      { target: 'aurum', reason: 'Financial data' },
      { target: 'job-portal', reason: 'Model internals' }
    ],
    'rag-assistant': [
      { target: 'friday-sermon', reason: 'Corpus text & audio' },
      { target: 'smartsyllabus', reason: 'Document RAG' },
      { target: 'second-brain', reason: 'Document synthesis' }
    ],
    'friday-sermon': [
      { target: 'rag-assistant', reason: 'Corpus scraping' }
    ],
    'second-brain': [
      { target: 'personal-ai-os', reason: 'Automated personal systems' },
      { target: 'rag-assistant', reason: 'Information retrieval' }
    ],
    'job-search': [
      { target: 'job-portal', reason: 'Plumbing to product' },
      { target: 'personal-ai-os', reason: 'n8n pipelines' },
      { target: 'sunadvantage', reason: 'Workflow automation' }
    ],
    'skoll': [
      { target: 'smartsyllabus', reason: 'Gemini prototype' },
      { target: 'presently', reason: 'Matching problem' }
    ],
    'presently': [
      { target: 'skoll', reason: 'Product surface testing' },
      { target: 'job-portal', reason: 'Matching logic' }
    ],
    'visual-design': [
      { target: 'editorial', reason: 'Print craft & signage' },
      { target: 'flingblade', reason: '3D spatial design' }
    ],
    'rbc': [
      { target: 'early-web', reason: 'First frontend reps' },
      { target: 'otpp', reason: 'Institutional engineering' }
    ]
  };

  const inspector = document.getElementById('station-inspector');
  const elTitle = document.getElementById('inspector-title');
  const elRole = document.getElementById('inspector-role');
  const elSummary = document.getElementById('inspector-summary');
  const elTimeframe = document.getElementById('inspector-timeframe');
  const elBullet = document.getElementById('inspector-bullet');
  const elLink = document.getElementById('inspector-link');
  const elLinkText = document.getElementById('inspector-link-text');
  const signTrack = document.getElementById('ttc-sign-track');
  const elStatusText = document.getElementById('ttc-sign-status');
  const elStationText = document.getElementById('ttc-sign-station');
  const elInterchangeBadge = document.getElementById('ttc-interchange-badge');
  const transfersContainer = document.getElementById('inspector-transfers');
  const transfersList = document.getElementById('inspector-transfers-list');
  const btnToggle = document.getElementById('inspector-toggle-details');
  const drawerSummary = document.getElementById('inspector-summary-drawer');
  const logoImgs = document.querySelectorAll('.logo-img');
  const nodes = document.querySelectorAll('.station-hit');
  const connectionsLayer = document.getElementById('cross-connections-layer');

  let currentId = 'sunadvantage';
  let slideTimeout = null;
  let arrivedTimeout = null;

  // Toggle summary drawer
  if (btnToggle && drawerSummary) {
    btnToggle.addEventListener('click', () => {
      const isHidden = drawerSummary.classList.contains('hidden');
      if (isHidden) {
        drawerSummary.classList.remove('hidden');
        btnToggle.setAttribute('aria-expanded', 'true');
      } else {
        drawerSummary.classList.add('hidden');
        btnToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Draw cross-line connections in SVG
  function renderConnections(stationId) {
    if (!connectionsLayer) return [];
    connectionsLayer.innerHTML = '';
    document.querySelectorAll('.station-hit').forEach((el) => el.classList.remove('connected-target'));

    const conns = CONNECTIONS[stationId] || [];
    const sourceStation = dataMap[stationId];
    if (!sourceStation || !conns.length) return [];

    const summaries = [];
    const strokeColor = routeColors[sourceStation.line] || 'var(--cobalt)';

    conns.forEach((c) => {
      const targetStation = dataMap[c.target];
      if (!targetStation) return;

      const sX = sourceStation.x;
      const sY = sourceStation.y;
      const tX = targetStation.x;
      const tY = targetStation.y;

      let pathD = '';
      if (sY === tY) {
        const midX = (sX + tX) / 2;
        const arcH = Math.min(50, Math.abs(tX - sX) * 0.25);
        pathD = `M ${sX} ${sY} Q ${midX} ${sY - arcH} ${tX} ${tY}`;
      } else {
        const midY = (sY + tY) / 2;
        pathD = `M ${sX} ${sY} C ${sX} ${midY}, ${tX} ${midY}, ${tX} ${tY}`;
      }

      const pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      pathEl.setAttribute('d', pathD);
      pathEl.setAttribute('class', 'connection-line-path');
      pathEl.setAttribute('stroke', strokeColor);
      pathEl.setAttribute('stroke-width', '3');
      pathEl.setAttribute('fill', 'none');
      pathEl.setAttribute('stroke-dasharray', '6 4');
      connectionsLayer.appendChild(pathEl);

      const targetEl = document.querySelector(`.station-hit[data-station-id="${c.target}"]`);
      if (targetEl) {
        targetEl.classList.add('connected-target');
      }

      summaries.push(`${targetStation.label} (${c.reason})`);
    });

    return summaries;
  }

  function updateInspector(stationId) {
    const s = dataMap[stationId];
    if (!s) return;

    if (inspector) {
      inspector.style.setProperty('--route', routeColors[s.line]);
    }

    if (elTitle) elTitle.textContent = `${s.organization}`;
    if (elRole) elRole.textContent = s.role;
    if (elSummary) elSummary.textContent = s.summary;
    if (elTimeframe) elTimeframe.textContent = s.timeframe;

    if (elBullet) {
      elBullet.className = `bullet bullet-${s.line} text-[11px] font-bold`;
      elBullet.textContent = s.routeName;
    }

    const logoBox = document.getElementById('inspector-logo');
    if (logoBox) logoBox.classList.toggle('hidden', !s.company);
    logoImgs.forEach((img) => {
      if (s.company && img.getAttribute('data-logo') === s.company) {
        img.classList.remove('hidden');
      } else {
        img.classList.add('hidden');
      }
    });

    if (elLink && elLinkText) {
      if (s.link) {
        elLink.style.display = 'inline-flex';
        elLink.setAttribute('href', s.link);
        if (s.link.startsWith('http')) {
          elLink.setAttribute('target', '_blank');
          elLink.setAttribute('rel', 'noopener noreferrer');
        } else {
          elLink.removeAttribute('target');
          elLink.removeAttribute('rel');
        }
        elLinkText.textContent = s.linkLabel || 'Read case study';
      } else {
        elLink.style.display = 'none';
      }
    }

    // Render active connections
    const connSummaries = renderConnections(stationId);
    if (transfersContainer && transfersList) {
      if (connSummaries.length > 0) {
        transfersContainer.classList.remove('hidden');
        transfersList.textContent = connSummaries.join(' · ');
      } else {
        transfersContainer.classList.add('hidden');
      }
    }

    if (elStationText) {
      elStationText.textContent = `${s.label} (${s.sub})`;
    }
  }

  function triggerArrivalTransition() {
    if (!signTrack) return;

    if (slideTimeout) clearTimeout(slideTimeout);
    if (arrivedTimeout) clearTimeout(arrivedTimeout);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (elStatusText) elStatusText.textContent = 'ARRIVED AT';
      return;
    }

    signTrack.classList.remove('ttc-slide-in', 'ttc-slide-prep-left');
    signTrack.classList.add('ttc-slide-out');

    slideTimeout = setTimeout(() => {
      if (elStatusText) elStatusText.textContent = 'ARRIVING AT';

      signTrack.classList.remove('ttc-slide-out');
      signTrack.classList.add('ttc-slide-prep-left');
      void signTrack.offsetWidth;

      signTrack.classList.remove('ttc-slide-prep-left');
      signTrack.classList.add('ttc-slide-in');

      arrivedTimeout = setTimeout(() => {
        if (elStatusText) {
          elStatusText.textContent = 'ARRIVED AT';
        }
      }, 550);
    }, 180);
  }

  function setCurrent(stationId) {
    const s = dataMap[stationId];
    if (!s) return;
    currentId = stationId;

    nodes.forEach((n) => {
      n.classList.toggle('current-station', n.getAttribute('data-station-id') === stationId);
    });

    const figure = document.getElementById('route-map-figure');
    if (figure && window.innerWidth < 768) {
      const scale = figure.scrollWidth / 1260;
      const targetScrollLeft = (s.x * scale) - (figure.clientWidth / 2);
      figure.scrollTo({ left: Math.max(0, targetScrollLeft), behavior: 'smooth' });
    }

    triggerArrivalTransition();
    updateInspector(stationId);
  }

  // Hover & selection listeners on station nodes
  nodes.forEach((n) => {
    const sid = n.getAttribute('data-station-id');
    if (!sid) return;

    n.addEventListener('mouseenter', () => {
      const connSummaries = renderConnections(sid);
      const s = dataMap[sid];
      if (s && elInterchangeBadge) {
        if (connSummaries.length > 0) {
          elInterchangeBadge.textContent = `⇄ ${s.label} CONNECTS TO: ${connSummaries.slice(0, 2).join(' · ')}`;
        } else {
          elInterchangeBadge.textContent = `⇄ ${s.label} (${s.organization})`;
        }
      }
    });

    n.addEventListener('mouseleave', () => {
      // Restore connections for the current selected station
      renderConnections(currentId);
      if (elInterchangeBadge) {
        elInterchangeBadge.textContent = '⇄ HOVER STATIONS TO VIEW CONNECTIONS';
      }
    });

    n.addEventListener('focus', () => setCurrent(sid));
    n.addEventListener('click', () => setCurrent(sid));
    n.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setCurrent(sid);
      }
    });
  });

  // Mobile View Switcher (Map vs List)
  const btnMap = document.getElementById('mobile-view-map');
  const btnList = document.getElementById('mobile-view-list');
  const mapView = document.getElementById('route-map-figure');
  const listView = document.getElementById('mobile-station-list-view');
  const quickStations = document.getElementById('mobile-quick-stations');
  const panHint = document.getElementById('mobile-pan-hint');

  if (btnMap && btnList && mapView && listView) {
    btnMap.addEventListener('click', () => {
      btnMap.classList.add('active');
      btnList.classList.remove('active');
      mapView.classList.remove('hidden');
      if (quickStations) quickStations.classList.remove('hidden');
      if (panHint) panHint.classList.remove('hidden');
      listView.classList.add('hidden');
    });

    btnList.addEventListener('click', () => {
      btnList.classList.add('active');
      btnMap.classList.remove('active');
      mapView.classList.add('hidden');
      if (quickStations) quickStations.classList.add('hidden');
      if (panHint) panHint.classList.add('hidden');
      listView.classList.remove('hidden');
    });
  }

  // Mobile quick chips & mobile list buttons
  document.querySelectorAll('[data-target-station]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const sid = chip.getAttribute('data-target-station');
      if (sid) setCurrent(sid);
    });
  });

  document.querySelectorAll('.mobile-list-station-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sid = btn.getAttribute('data-station-id');
      if (sid) {
        setCurrent(sid);
        if (inspector) {
          inspector.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }
    });
  });

  // Default current station: SunAdvantage
  setCurrent('sunadvantage');
</script>
