/**
 * The route diagram. Rohan's path as a transit line.
 * 45 and 90 degree angles only. Draws itself once on load.
 * Click, tap or keyboard focus a station to make it the current one. The train
 * rides the track to it, rerouting mid-ride if the target changes, and the panel
 * above the diagram updates to match. Hover only highlights a station ring; it no
 * longer sends the train, because a mouse crossing the diagram used to whip it
 * back and forth.
 *
 * Geometry (viewBox 0 0 1240 800, main line at y=310). Five routes:
 *   line 1 strategy      M 0 310 H 1240                    = 1240
 *   line 3 startup       M 790 310 L 950 150 H 1240        = sqrt(160^2+160^2) + 290
 *   line 2 ai tools      M 790 310 L 950 470 H 1240        = sqrt(160^2+160^2) + 290
 *   line 4 data          M 150 310 L 520 680 H 1240        = sqrt(370^2+370^2) + 720
 *   line 5 earlier work  M 0 110 H 780                     = 780
 * Line 5 has no junction. It enters from the left edge like line 1 and terminates
 * at 780, before the line 3 diagonal climbs through that column. Its row is 110
 * rather than 150 so it clears the line 1 logo block, which starts at y=166. Line 4 leaves the
 * spine early (x=150) because the data work predates the AI tool work by two years,
 * and it needs the extra horizontal run to carry six stations.
 * Every constant below mirrors one of these paths. Change them together.
 *
 * Vertical rhythm per station, measured from the line, mirrored on both sides:
 *   name baseline 40, year baseline 62, logo block from 82 to 138.
 * Logos are for employers only. Project stations set no company, skip the logo
 * block entirely, and can therefore sit at a 105 to 130px pitch instead of 150.
 * The stack extent (138) plus node clearance is why the branch offset is 160.
 *
 * Timing. The line draws at one constant speed, so every station delay is derived
 * from its distance along the path by mainDelay() and branchDelay() below. Moving a
 * station only means changing its x.
 */
import CompanyLogo from './CompanyLogo.astro';
import Icon from './Icon.astro';

const LINE_START_X = 0;
const LINE_END_X = 1240;
const JUNCTION_X = 790;
const BEND_X = 950;

const DRAW_SPEED = 1150 / 1500; // px per ms, the original line-draw speed
const MAIN_LEN = LINE_END_X - LINE_START_X;
const MAIN_DUR = Math.round(MAIN_LEN / DRAW_SPEED);
const BRANCH_DIAG = Math.round(Math.hypot(160, 160)); // the 45 degree leg off the junction
const BRANCH_LEN = BRANCH_DIAG + (LINE_END_X - BEND_X);
const BRANCH_DUR = Math.round(BRANCH_LEN / DRAW_SPEED);
const BRANCH_START = Math.round((JUNCTION_X - LINE_START_X) / DRAW_SPEED);

// Line 4 - data. Leaves the spine at x=150 and drops 370px at 45 degrees to its row.
const DATA_JUNCTION_X = 150;
const DATA_BEND_X = 520;
const DATA_ROW_Y = 680;
const DATA_DROP = DATA_BEND_X - DATA_JUNCTION_X; // 370, equals the vertical drop
const DATA_DIAG = Math.round(Math.hypot(DATA_DROP, DATA_DROP));
const DATA_LEN = DATA_DIAG + (LINE_END_X - DATA_BEND_X);
const DATA_DUR = Math.round(DATA_LEN / DRAW_SPEED);
const DATA_START = Math.round((DATA_JUNCTION_X - LINE_START_X) / DRAW_SPEED);

// Line 5 - earlier work. No junction, enters from the left edge and terminates.
const EARLY_ROW_Y = 110;
const EARLY_END_X = 780;
const EARLY_LEN = EARLY_END_X - LINE_START_X;
const EARLY_DUR = Math.round(EARLY_LEN / DRAW_SPEED);

const mainDelay = (x: number) => Math.round((x - LINE_START_X) / DRAW_SPEED);
const branchDelay = (x: number) =>
  Math.round(BRANCH_START + (BRANCH_DIAG + (x - BEND_X)) / DRAW_SPEED);
const dataDelay = (x: number) =>
  Math.round(DATA_START + (DATA_DIAG + (x - DATA_BEND_X)) / DRAW_SPEED);
const earlyDelay = (x: number) => Math.round((x - LINE_START_X) / DRAW_SPEED);

const LOGO_W = 120;
const LOGO_H = 56;

