  // Render cross-line connection paths in SVG
  function drawConnections(stationId) {
    if (!connectionsLayer) return;
    connectionsLayer.innerHTML = '';
    nodes.forEach((el) => el.classList.remove('connected-target'));

    const conns = CONNECTIONS[stationId] || [];
    const sourceStation = dataMap[stationId];
    if (!sourceStation || !conns.length) return;

    const strokeColor = 'var(--ink)';

    conns.forEach((c) => {
      const targetStation = dataMap[c.target];
      if (!targetStation) return;

      const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      group.setAttribute('class', 'connection-edge');
      group.setAttribute('data-source', stationId);
      group.setAttribute('data-target', c.target);
      group.style.cursor = 'pointer';

      const sx = sourceStation.x;
      const sy = sourceStation.y;
      const tx = targetStation.x;
      const ty = targetStation.y;

      const dx = tx - sx;
      const dy = ty - sy;
      const dist = Math.sqrt(dx * dx + dy * dy);

      const offsetMag = Math.min(65, Math.max(25, dist * 0.18));
      const nx = -dy / (dist || 1);
      const ny = dx / (dist || 1);

      const sign = (stationId < c.target) ? 1 : -1;
      const cx = (sx + tx) / 2 + nx * offsetMag * sign;
      const cy = (sy + ty) / 2 + ny * offsetMag * sign;

      const d = `M ${sx} ${sy} Q ${cx} ${cy} ${tx} ${ty}`;

      const hitPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      hitPath.setAttribute('d', d);
      hitPath.setAttribute('stroke', 'transparent');
      hitPath.setAttribute('stroke-width', '24');
      hitPath.setAttribute('fill', 'none');
      hitPath.setAttribute('class', 'connection-hit-pad');

      const visPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      visPath.setAttribute('d', d);
      visPath.setAttribute('class', 'connection-line-path');
      visPath.setAttribute('stroke', strokeColor);
      visPath.setAttribute('stroke-width', '4');
      visPath.setAttribute('stroke-linecap', 'round');
      visPath.setAttribute('stroke-dasharray', '2 12');
      visPath.setAttribute('fill', 'none');

      group.appendChild(hitPath);
      group.appendChild(visPath);

      group.addEventListener('mouseenter', () => {
        clearTimeout(restoreTimer);
        group.classList.add('active-connection');
        updateTransfer(sourceStation, targetStation, c);
      });

      group.addEventListener('mouseleave', () => {
        group.classList.remove('active-connection');
        scheduleRestore();
      });

      group.addEventListener('click', (e) => {
        e.stopPropagation();
        group.classList.add('active-connection');
        updateTransfer(sourceStation, targetStation, c);
      });

      connectionsLayer.appendChild(group);

      const targetEl = document.querySelector(`.station-hit[data-station-id="${c.target}"]`);
      if (targetEl) {
        targetEl.classList.add('connected-target');
      }
    });
  }

  function updateInspector(stationId) {
    clearTimeout(restoreTimer);
    const s = dataMap[stationId];
    if (!s || !inspector) return;

    activeStationId = stationId;

    if (inspBadge) {
      inspBadge.className = `bullet bullet-${s.line} text-[12.5px] font-bold uppercase tracking-wider`;
      inspBadge.style.backgroundColor = '';
      inspBadge.style.color = '';
      inspBadge.textContent = s.routeName;
    }
    if (inspTitle) inspTitle.textContent = s.label;
    if (inspLogoBox && inspLogoImg) {
      if (s.company) {
        inspLogoImg.src = `/images/logos/${s.company}.png`;
        inspLogoBox.classList.remove('hidden');
        inspLogoBox.classList.add('inline-flex');
      } else {
        inspLogoBox.classList.add('hidden');
        inspLogoBox.classList.remove('inline-flex');
      }
    }

    if (s.roles && s.roles.length > 1) {
      if (inspTimeframeRow) inspTimeframeRow.classList.add('hidden');
      if (inspRolesTimeline) {
        inspRolesTimeline.classList.remove('hidden');
        inspRolesTimeline.innerHTML = '';
        s.roles.forEach((r) => {
          const item = document.createElement('div');
          item.className = 'relative pl-1';
          item.innerHTML = `
            <span class="absolute -left-[22px] top-1.5 h-2.5 w-2.5 rounded-full bg-(--ink) border-2 border-(--ground)"></span>
            <div class="text-[14.5px] font-bold text-(--ink) leading-snug">${r.title}</div>
            <div class="text-[12px] font-mono text-(--ink-muted) mt-0.5">${r.team ? r.team + ' · ' : ''}${r.timeframe}${r.type ? ' · ' + r.type : ''}</div>
          `;
          inspRolesTimeline.appendChild(item);
        });
      }
      if (inspRole) {
        inspRole.textContent = 'Multiple roles';
      }
    } else {
      if (inspRolesTimeline) {
        inspRolesTimeline.classList.add('hidden');
        inspRolesTimeline.innerHTML = '';
      }
      if (inspTimeframeRow) {
        inspTimeframeRow.classList.remove('hidden');
        if (inspTimeframe) inspTimeframe.textContent = s.timeframe;
      }
      if (inspRole) {
        const orgClean = s.organization.replace(/\(.*?\)/g, '').trim().toLowerCase();
        const lblClean = s.label.toLowerCase();
        inspRole.textContent = orgClean === lblClean ? s.role : `${s.organization} · ${s.role}`;
      }
    }

    if (inspSummary) inspSummary.textContent = s.summary;

    if (inspLinkPrimary && inspLinkText) {
      if (s.link) {
        inspLinkPrimary.style.display = 'inline-flex';
        inspLinkPrimary.setAttribute('href', s.link);
        inspLinkText.textContent = s.linkLabel || 'Learn more';
      } else {
        inspLinkPrimary.style.display = 'none';
      }
    }

    if (inspLinkSecondary) inspLinkSecondary.style.display = 'none';

    // Populate connected stations pills (clear, legible 12px buttons)
    const conns = CONNECTIONS[stationId] || [];
    if (inspConnsSection && inspConnsList) {
      if (conns.length > 0) {
        inspConnsSection.style.display = 'block';
        inspConnsList.innerHTML = '';
        conns.forEach((c) => {
          const target = dataMap[c.target];
          if (!target) return;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'px-3 py-1.5 border-2 border-(--ink) font-mono text-[12px] font-bold uppercase transition-colors hover:bg-(--ink) hover:text-(--ground) flex items-center gap-2 cursor-pointer';
          btn.innerHTML = `<span class="inline-block h-2 w-2 rounded-full shrink-0" style="background:${routeColors[target.line]}"></span><span>${target.label}</span>`;
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            pinnedStationId = target.id;
            updateInspector(target.id);
            drawConnections(target.id);
          });
          inspConnsList.appendChild(btn);
        });
      } else {
        inspConnsSection.style.display = 'none';
      }
    }

    nodes.forEach((n) => {
      n.classList.toggle('current-station', n.getAttribute('data-station-id') === stationId);
    });

    drawConnections(stationId);
  }

  function updateTransfer(source, target, conn) {
    clearTimeout(restoreTimer);
    if (!inspector) return;

    if (inspLogoBox) {
      inspLogoBox.classList.add('hidden');
      inspLogoBox.classList.remove('inline-flex');
    }

    if (inspRolesTimeline) {
      inspRolesTimeline.classList.add('hidden');
      inspRolesTimeline.innerHTML = '';
    }
    if (inspTimeframeRow) {
      inspTimeframeRow.classList.remove('hidden');
    }

    if (inspBadge) {
      inspBadge.className = 'bullet text-[12px] font-bold uppercase tracking-wider';
      inspBadge.style.backgroundColor = 'var(--ink)';
      inspBadge.style.color = 'var(--ground)';
      inspBadge.textContent = 'CONNECTION';
    }
    if (inspTimeframe) {
      inspTimeframe.textContent = conn.reason;
    }
    if (inspTitle) {
      inspTitle.innerHTML = `
        <span class="inline-flex items-center gap-2 flex-wrap text-[18px] sm:text-[20px] font-bold leading-snug">
          <span class="text-(--ink)">${source.label}</span>
          <svg class="w-4 h-4 text-(--ink) shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 16l-4-4 4-4"></path>
            <path d="M3 12h18"></path>
            <path d="M17 8l4 4-4 4"></path>
          </svg>
          <span class="text-(--ink)">${target.label}</span>
        </span>
      `;
    }
    if (inspRole) {
      inspRole.textContent = `${source.routeName} ↔ ${target.routeName}`;
    }
    if (inspSummary) {
      inspSummary.textContent = conn.why;
    }

    if (inspLinkPrimary && inspLinkText) {
      if (source.link) {
        inspLinkPrimary.style.display = 'inline-flex';
        inspLinkPrimary.setAttribute('href', source.link);
        inspLinkText.textContent = `Learn more: ${source.label}`;
      } else {
        inspLinkPrimary.style.display = 'none';
      }
    }

    if (inspLinkSecondary && inspLinkSecondaryText) {
      if (target.link) {
        inspLinkSecondary.classList.remove('hidden');
        inspLinkSecondary.style.display = 'inline-flex';
        inspLinkSecondary.setAttribute('href', target.link);
        inspLinkSecondaryText.textContent = `Learn more: ${target.label}`;
      } else {
        inspLinkSecondary.style.display = 'none';
      }
    }

    if (inspConnsSection) inspConnsSection.style.display = 'none';
  }

  function scheduleRestore() {
    clearTimeout(restoreTimer);
    restoreTimer = setTimeout(() => {
      updateInspector(pinnedStationId);
    }, 300);
  }

  // Station node event listeners
  nodes.forEach((n) => {
    const sid = n.getAttribute('data-station-id');
    if (!sid) return;

    n.addEventListener('mouseenter', () => {
      updateInspector(sid);
    });

    n.addEventListener('mouseleave', scheduleRestore);

    n.addEventListener('click', (e) => {
      e.stopPropagation();
      pinnedStationId = sid;
      updateInspector(sid);
    });

    n.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        pinnedStationId = sid;
        updateInspector(sid);
      }
    });
  });

  if (inspector) {
    inspector.addEventListener('mouseenter', () => clearTimeout(restoreTimer));
    inspector.addEventListener('mouseleave', scheduleRestore);
  }

  // Initial load: populate with current anchor station (Sun Life)
  updateInspector(pinnedStationId);

  // Mobile Accordion Directory handling
  document.querySelectorAll('.mobile-station-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.mobile-station-accordion');
      const drawer = parent ? parent.querySelector('.mobile-station-drawer') : null;
      if (!drawer) return;

      const isExpanded = !drawer.classList.contains('hidden');

      // Close all other drawers
      document.querySelectorAll('.mobile-station-drawer').forEach((d) => d.classList.add('hidden'));

      if (!isExpanded) {
        drawer.classList.remove('hidden');
        const sid = btn.getAttribute('data-station-id');
        const connsContainer = drawer.querySelector('.mobile-conns-list');
        if (connsContainer && sid) {
          const conns = CONNECTIONS[sid] || [];
          connsContainer.innerHTML = '';
          if (conns.length === 0) {
            drawer.querySelector('.mobile-station-conns').style.display = 'none';
          } else {
            drawer.querySelector('.mobile-station-conns').style.display = 'block';
            conns.forEach((c) => {
              const target = dataMap[c.target];
              if (!target) return;
              const pill = document.createElement('a');
              pill.href = target.link || '#';
              pill.className = 'px-3 py-1.5 border-2 border-(--ink) font-mono text-[12px] font-bold uppercase transition-colors hover:bg-(--ink) hover:text-(--ground) flex items-center gap-2';
              pill.innerHTML = `<span class="inline-block h-2 w-2 rounded-full shrink-0" style="background:${routeColors[target.line]}"></span><span>${target.label} (${c.reason})</span>`;
              connsContainer.appendChild(pill);
            });
          }
        }
      }
    });
  });

  // Mobile View Switcher (List vs Map)
  const btnMap = document.getElementById('mobile-view-map');
  const btnList = document.getElementById('mobile-view-list');
  const gridContainer = document.getElementById('route-system-grid');
  const listView = document.getElementById('mobile-station-list-view');
  const panHint = document.getElementById('mobile-pan-hint');

  if (btnMap && btnList && gridContainer && listView) {
    btnMap.addEventListener('click', () => {
      btnMap.classList.add('active');
      btnList.classList.remove('active');
      gridContainer.classList.remove('hidden');
      gridContainer.classList.add('flex');
      if (panHint) panHint.classList.remove('hidden');
      listView.classList.add('hidden');
    });

    btnList.addEventListener('click', () => {
      btnList.classList.add('active');
      btnMap.classList.remove('active');
      gridContainer.classList.add('hidden');
      gridContainer.classList.remove('flex');
      if (panHint) panHint.classList.add('hidden');
      listView.classList.remove('hidden');
    });
  }
</script>
