        <span class="inline-block h-2 w-2 rounded-full bg-[#F2B705] animate-pulse"></span>
        <span id="ttc-status-text">ARRIVED AT</span>
      </div>
    </div>

    <!-- Active Station Quick Info Row -->
    <div class="p-3.5 sm:p-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        <!-- Logo Box: Transparent background, no border, clean alignment -->
        <div id="inspector-logo" class="flex h-14 w-20 shrink-0 items-center justify-center">
          <CompanyLogo name="sunlife" width={80} height={40} class="logo-img h-full w-full object-contain" data-logo="sunlife" />
          <CompanyLogo name="rbc" width={80} height={40} class="logo-img h-full w-full object-contain hidden" data-logo="rbc" />
          <CompanyLogo name="otpp" width={80} height={40} class="logo-img h-full w-full object-contain hidden" data-logo="otpp" />
          <CompanyLogo name="uoft" width={80} height={40} class="logo-img h-full w-full object-contain hidden" data-logo="uoft" />
          <CompanyLogo name="dyedurham" width={80} height={40} class="logo-img h-full w-full object-contain hidden" data-logo="dyedurham" />
          <CompanyLogo name="smartsyllabus" width={80} height={40} class="logo-img h-full w-full object-contain hidden" data-logo="smartsyllabus" />
          <CompanyLogo name="n8n" width={80} height={40} class="logo-img h-full w-full object-contain hidden" data-logo="n8n" />
        </div>

        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span id="inspector-bullet" class="bullet bullet-1 text-[11px] font-bold">Line 1 · Strategy</span>
            <span id="inspector-timeframe" class="label text-[12px] text-(--ink-faint)">2026 – Present</span>
          </div>
          <h3 id="inspector-title" class="mt-0.5 text-[17px] sm:text-[19px] font-bold text-(--ink) truncate">
            Sun Life (SunAdvantage)
          </h3>
          <div id="inspector-role" class="label text-[13px] font-bold text-(--cobalt) truncate">
            Strategy & Operations Specialist
          </div>
        </div>
      </div>

      <!-- Action & Collapsible Details Toggle -->
      <div class="flex items-center gap-2.5 shrink-0 self-start md:self-center">
        <button
          type="button"
          id="inspector-toggle-details"
          class="btn btn-secondary text-[11px] h-8 px-3 flex items-center gap-1.5"
          aria-expanded="false"
          aria-controls="inspector-summary-drawer"
        >
          <span id="toggle-details-text">Summary</span>
          <Icon name="arrow-down" size={12} class="transition-transform duration-200" />
        </button>

        <a
          id="inspector-link"
          href="#"
          class="btn btn-primary text-[11px] h-8 px-3 flex items-center gap-1.5"
          style="display: none;"
        >
          <span id="inspector-link-text">Case study</span>
          <Icon name="arrow-right" size={12} />
        </a>
      </div>
    </div>

    <!-- Collapsible Summary Drawer -->
    <div
      id="inspector-summary-drawer"
      class="hidden border-t-2 border-(--rule-soft) bg-(--surface) px-4 py-3"
    >
      <p id="inspector-summary" class="max-w-[90ch] text-[13px] sm:text-[14px] leading-relaxed text-(--ink)">
        Full time strategy and operations on the SunAdvantage group benefits platform, which modernizes health and dental coverage for small and medium businesses. Just started, so there is nothing to write up yet.
      </p>
    </div>
  </div>

  <!-- Mobile View Switcher: Map View vs Station List View -->
