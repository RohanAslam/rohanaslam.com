---
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'work'> }

const { entry } = Astro.props;
const { title, summary, stack, status, date, tags } = entry.data;
const fmt = new Intl.DateTimeFormat('en-CA', { month: 'short', year: 'numeric' });

const ROUTES: Record<string, { n: number; name: string }> = {
  strategy: { n: 1, name: 'Line 1 · Corporate' },
  startup: { n: 2, name: 'Line 2 · Business Ventures' },
  'ai-tools': { n: 3, name: 'Line 3 · AI Tools' },
  data: { n: 4, name: 'Line 4 · Data' },
  'earlier-work': { n: 5, name: 'Line 5 · Writing' },
};
const primaryKey = tags[0];
const primary = ROUTES[primaryKey] ?? ROUTES['earlier-work'];
---

<a
  href={`/work/${entry.id}`}
  class="station-card group"
  style={`--route: var(--line-${primary.n})`}
  data-line={primaryKey}
  data-tags={tags.join(' ')}
>
  <div class="label flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px]">
    <span class={`bullet bullet-${primary.n} text-[12px] font-bold`}>{primary.name}</span>
    <span>{fmt.format(date)}</span>
    <span class="text-(--ink-faint)">{status}</span>
  </div>
  <h3 class="mt-3 text-[21px] font-bold leading-snug transition-colors group-hover:text-(--cobalt)">
    {title}
  </h3>
  <p class="mt-2 max-w-[90ch] text-[15px] leading-relaxed text-(--ink-muted)">{summary}</p>
  {
    stack.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {stack.slice(0, 5).map((s) => <span class="tag text-[12px]">{s}</span>)}
      </div>
    )
  }
</a>
